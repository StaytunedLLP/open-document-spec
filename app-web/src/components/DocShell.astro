---
// FILE: DocShell.astro
// Purpose: Unified layout shell for Docs and Specs with left sidebar, central MDX renderer, right-side outline view, and full site navigation integration.

import Layout from "../layouts/Layout.astro";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface DocEntry {
  id: string;
  data: {
    title?: string;
    description?: string;
    status?: string;
    ods?: Record<string, any>;
    [key: string]: any;
  };
}

interface Props {
  collection: "docs" | "specs";
  currentEntry: DocEntry;
  allEntries: DocEntry[];
  Content: any;
  headings: Heading[];
}

const { collection, currentEntry, allEntries, Content, headings } = Astro.props;

// Sort entries logically by explicit frontmatter `order`, falling back to filename
const sortedEntries = [...allEntries].sort((a, b) => {
  const orderA = typeof a.data?.order === "number" ? a.data.order : (a.id?.includes("index") ? 0 : 999);
  const orderB = typeof b.data?.order === "number" ? b.data.order : (b.id?.includes("index") ? 0 : 999);
  if (orderA !== orderB) return orderA - orderB;
  const idA = a.id || "";
  const idB = b.id || "";
  return idA.localeCompare(idB);
});

// Group sorted entries into logical nested categories / accordions
interface CategoryGroup {
  name: string;
  items: DocEntry[];
}

const categories: CategoryGroup[] = [];

if (collection === "docs") {
  const coreItems = sortedEntries.filter((e) => !e.id.includes("/") && (e.data?.order ?? 99) < 8);
  const refItems = sortedEntries.filter((e) => !e.id.includes("/") && (e.data?.order ?? 99) >= 8);
  const useCaseItems = sortedEntries.filter((e) => e.id.startsWith("use-cases/"));

  if (coreItems.length) categories.push({ name: "Core User Guides", items: coreItems });
  if (refItems.length) categories.push({ name: "Reference & Ops", items: refItems });
  if (useCaseItems.length) categories.push({ name: "Enterprise Use Cases", items: useCaseItems });
} else {
  // Specs collection: group by dialect folder (ods/, okf/, skills/)
  const isIndexFile = (id: string) =>
    /(^|\/)index(\.ods)?\.(md|mdx)$/i.test(id) || id === "index.ods.md" || id === "index.md";
  const contentEntries = sortedEntries.filter((e) => !isIndexFile(e.id || ""));
  const byPrefix = (prefix: string) =>
    contentEntries.filter((e) => (e.id || "").replace(/\\/g, "/").startsWith(prefix));

  const odsItems = byPrefix("ods/");
  const okfItems = byPrefix("okf/");
  const skillsItems = byPrefix("skills/");
  const otherItems = contentEntries.filter((e) => {
    const id = (e.id || "").replace(/\\/g, "/");
    return !id.startsWith("ods/") && !id.startsWith("okf/") && !id.startsWith("skills/");
  });

  if (odsItems.length) categories.push({ name: "ODS (default)", items: odsItems });
  if (okfItems.length) categories.push({ name: "OKF (--okf)", items: okfItems });
  if (skillsItems.length) categories.push({ name: "Skills (--skills)", items: skillsItems });
  if (otherItems.length) categories.push({ name: "Other", items: otherItems });
}

if (!categories.length) {
  categories.push({ name: collection === "docs" ? "All Guides" : "All Specs", items: sortedEntries });
}

const currentId = currentEntry.id || "";

// Find current index for Prev / Next links
const currentIndex = sortedEntries.findIndex((e) => e.id === currentId);
const prevEntry = currentIndex > 0 ? sortedEntries[currentIndex - 1] : null;
const nextEntry = currentIndex < sortedEntries.length - 1 ? sortedEntries[currentIndex + 1] : null;

// Determine titles & metadata
const docTitle = currentEntry.data.title || currentId.replace(/\.(md|mdx)$/, "").replace(/^[0-9]+-/, "").replace(/-/g, " ");
const docDesc = currentEntry.data.description || "";
const docStatus = currentEntry.data.status || currentEntry.data.ods?.status || "active";
const docProfile = currentEntry.data.ods?.profile || (collection === "docs" ? "guide" : "spec");
const isMdx = currentId.endsWith(".mdx");

const activeNav = collection === "docs" ? "docs" : "spec";
const sectionTitle = collection === "docs" ? "User Guides & Docs" : "Specification & Rules";
---

<Layout title={`${docTitle} — ODS ${collection === "docs" ? "Documentation" : "Specification"}`} activeNav={activeNav}>
  <div class="doc-shell-container">
    <!-- Left Navigation Sidebar (Nested Category Accordions) -->
    <aside class="doc-sidebar-left">
      <div class="sidebar-header-box">
        <span class="sidebar-section-pill">{collection === "docs" ? "MDX Docs" : "Spec Files"}</span>
        <h2 class="sidebar-section-title">{sectionTitle}</h2>
      </div>

      <nav class="sidebar-nav-list">
        {
          categories.map((cat) => {
            const hasActiveChild = cat.items.some((item) => item.id === currentId);

            return (
              <details class="sidebar-category-group" open={hasActiveChild || true}>
                <summary class="sidebar-category-title">
                  <span class="cat-label">{cat.name}</span>
                  <span class="cat-badge">{cat.items.length}</span>
                  <svg class="cat-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </summary>
                <div class="sidebar-category-items">
                  {cat.items.map((item) => {
                    const itemId = item.id || "";
                    const itemSlug = itemId.replace(/\.(md|mdx)$/, "");
                    const isActive = itemId === currentId;
                    const rawName = itemSlug.replace(/^.*\//, "");
                    const itemTitle = item.data.title || rawName.replace(/-/g, " ");
                    const itemIsMdx = itemId.endsWith(".mdx");

                    return (
                      <a
                        href={`/${collection}/${itemSlug}`}
                        class:list={["sidebar-nav-item", { active: isActive }]}
                      >
                        <div class="item-title-row">
                          <span class="item-label">{itemTitle}</span>
                        </div>
                        <div class="item-meta-row">
                          <span class:list={["type-badge", { mdx: itemIsMdx }]}>
                            {itemIsMdx ? "MDX" : "MD"}
                          </span>
                          {item.data.ods?.profile && (
                            <span class="profile-badge">{item.data.ods.profile}</span>
                          )}
                        </div>
                      </a>
                    );
                  })}
                </div>
              </details>
            );
          })
        }
      </nav>
    </aside>

    <!-- Main Content Area -->
    <main class="doc-content-main">
      <header class="doc-header">
        <div class="doc-breadcrumbs">
          <a href="/">Home</a>
          <span class="sep">/</span>
          <a href={`/${collection}`}>{collection === "docs" ? "Docs" : "Spec"}</a>
          <span class="sep">/</span>
          <span class="current">{docTitle}</span>
        </div>

        <div class="doc-title-row">
          <h1 class="doc-main-title">{docTitle}</h1>
        </div>

        <div class="doc-tags-row">
          <span class:list={["doc-status-tag", docStatus]}>{docStatus}</span>
          <span class="doc-profile-tag">profile: {docProfile}</span>
          {isMdx && <span class="doc-mdx-tag">MDX Component Ready</span>}
        </div>

        {docDesc && <p class="doc-main-desc">{docDesc}</p>}
      </header>

      <hr class="doc-divider" />

      <!-- Rendered Article Body -->
      <article class="doc-article-body markdown-body">
        <Content />
      </article>

      <!-- Bottom Next / Previous Page Navigation -->
      <footer class="doc-footer-nav">
        {prevEntry ? (
          <a href={`/${collection}/${prevEntry.id.replace(/\.(md|mdx)$/, "")}`} class="nav-card prev-card">
            <span class="card-direction">← Previous</span>
            <span class="card-title">{prevEntry.data.title || prevEntry.id}</span>
          </a>
        ) : (
          <div />
        )}

        {nextEntry ? (
          <a href={`/${collection}/${nextEntry.id.replace(/\.(md|mdx)$/, "")}`} class="nav-card next-card">
            <span class="card-direction">Next →</span>
            <span class="card-title">{nextEntry.data.title || nextEntry.id}</span>
          </a>
        ) : (
          <div />
        )}
      </footer>
    </main>

    <!-- Right Side Outline View (Zero Bullet Icons) -->
    <aside class="doc-sidebar-right">
      <div class="outline-box">
        <div class="outline-header">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="8" y1="6" x2="21" y2="6"></line>
            <line x1="8" y1="12" x2="21" y2="12"></line>
            <line x1="8" y1="18" x2="21" y2="18"></line>
            <line x1="3" y1="6" x2="3.01" y2="6"></line>
            <line x1="3" y1="12" x2="3.01" y2="12"></line>
            <line x1="3" y1="18" x2="3.01" y2="18"></line>
          </svg>
          <span>On this page</span>
        </div>

        {headings.length > 0 ? (
          <nav class="outline-nav" id="right-outline-nav">
            {headings
              .filter((h) => h.depth >= 2 && h.depth <= 4)
              .map((h) => (
                <a
                  href={`#${h.slug}`}
                  class:list={["outline-link", `depth-${h.depth}`]}
                  data-heading-id={h.slug}
                >
                  {h.text}
                </a>
              ))}
          </nav>
        ) : (
          <p class="outline-empty">No section headings found.</p>
        )}
      </div>
    </aside>
  </div>
</Layout>

<script>
  // Right-side outline active heading tracking script & relative link repair script
  function setupDocInteractive() {
    // 0. Setup Mobile Docs Navigation Drawer Toggle
    const mobileDocsToggle = document.getElementById("mobile-docs-toggle");
    const docSidebarLeft = document.querySelector(".doc-sidebar-left");
    if (mobileDocsToggle && docSidebarLeft) {
      mobileDocsToggle.addEventListener("click", () => {
        const isOpen = docSidebarLeft.classList.toggle("mobile-open");
        mobileDocsToggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
        mobileDocsToggle.classList.toggle("open", isOpen);
      });
    }

    // 1. Repair markdown internal .md links dynamically to prevent 404s
    const articleBody = document.querySelector(".doc-article-body");
    if (articleBody) {
      const links = articleBody.querySelectorAll("a");
      links.forEach((a) => {
        let href = a.getAttribute("href");
        if (!href || href.startsWith("http://") || href.startsWith("https://") || href.startsWith("#")) return;

        if (href.endsWith(".md") || href.endsWith(".mdx")) {
          href = href.replace(/\.(md|mdx)$/, "");
        }

        // Strip any legacy numeric prefixes (e.g. 03-adoption -> adoption)
        href = href.replace(/(^|\/)[0-9]+-([a-zA-Z0-9_-]+)/g, "$1$2");

        if (!href.startsWith("/")) {
          const cleanName = href.replace(/^\.\//, "").replace(/^.*[\\\/]/, "").replace(/^[0-9]+-/, "");
          const currentPath = window.location.pathname;
          const baseSection = currentPath.startsWith("/docs") ? "docs" : (currentPath.startsWith("/specs") ? "specs" : "spec");
          href = `/${baseSection}/${cleanName}`;
        }

        a.setAttribute("href", href);
      });
    }

    // 2. Wrap Markdown Tables in a responsive container wrapper
    const tables = document.querySelectorAll<HTMLTableElement>(".doc-article-body table");
    tables.forEach((table) => {
      if (!table.parentElement?.classList.contains("table-wrapper")) {
        const wrapper = document.createElement("div");
        wrapper.className = "table-wrapper";
        table.parentNode?.insertBefore(wrapper, table);
        wrapper.appendChild(table);
      }
    });

    // 3. Highlight GitHub Callouts ([!TIP], [!NOTE], [!IMPORTANT], [!WARNING], [!CAUTION])
    const blockquotes = document.querySelectorAll<HTMLQuoteElement>(".doc-article-body blockquote");
    blockquotes.forEach((bq) => {
      const text = bq.innerHTML;
      const types = [
        { key: "[!TIP]", cls: "callout-tip", title: "Tip", svg: `<svg class="callout-icon" viewBox="0 0 16 16" width="16" height="16" fill="currentColor"><path d="M8 1.5c-2.363 0-4 1.69-4 3.75 0 1.256.54 2.298 1.272 3.1.347.38.718.777.94 1.15.223.373.288.75.288 1.25v.75c0 .414.336.75.75.75h1.5a.75.75 0 0 0 .75-.75V10.75c0-.5.065-.877.288-1.25.222-.373.593-.77.94-1.15C11.46 7.548 12 6.506 12 5.25c0-2.06-1.637-3.75-4-3.75ZM5.75 12h4.5a.75.75 0 0 1 .75.75v.5a.75.75 0 0 1-.75.75h-4.5a.75.75 0 0 1-.75-.75v-.5a.75.75 0 0 1 .75-.75ZM6.5 14.5h3a.75.75 0 0 1 .75.75v.25a.75.75 0 0 1-.75.75h-3a.75.75 0 0 1-.75-.75v-.25a.75.75 0 0 1 .75-.75Z"></path></svg>` },
        { key: "[!NOTE]", cls: "callout-note", title: "Note", svg: `<svg class="callout-icon" viewBox="0 0 16 16" width="16" height="16" fill="currentColor"><path d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8Zm8-6.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13ZM6.5 7.75A.75.75 0 0 1 7.25 7h1a.75.75 0 0 1 .75.75v2.75h.25a.75.75 0 0 1 0 1.5h-1.5a.75.75 0 0 1 0-1.5h.25v-2h-.25a.75.75 0 0 1-.75-.75ZM8 6a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z"></path></svg>` },
        { key: "[!IMPORTANT]", cls: "callout-important", title: "Important", svg: `<svg class="callout-icon" viewBox="0 0 16 16" width="16" height="16" fill="currentColor"><path d="M0 1.75C0 .784.784 0 1.75 0h12.5C15.216 0 16 .784 16 1.75v9.5A1.75 1.75 0 0 1 14.25 13H11l-2.5 2.5a.75.75 0 0 1-1 0L5 13H1.75A1.75 1.75 0 0 1 0 11.25Zm1.75-.25a.25.25 0 0 0-.25.25v9.5c0 .138.112.25.25.25h3.5a.75.75 0 0 1 .53.22L8 14.44l2.47-2.47a.75.75 0 0 1 .53-.22h3.25a.25.25 0 0 0 .25-.25v-9.5a.25.25 0 0 0-.25-.25ZM8 3.5a.75.75 0 0 1 .75.75v2.5a.75.75 0 0 1-1.5 0v-2.5A.75.75 0 0 1 8 3.5Zm0 6a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z"></path></svg>` },
        { key: "[!WARNING]", cls: "callout-warning", title: "Warning", svg: `<svg class="callout-icon" viewBox="0 0 16 16" width="16" height="16" fill="currentColor"><path d="M6.457 1.047c.659-1.234 2.427-1.234 3.086 0l6.082 11.378A1.75 1.75 0 0 1 14.082 15H1.918a1.75 1.75 0 0 1-1.543-2.575Zm1.763.707a.25.25 0 0 0-.44 0L1.698 13.132a.25.25 0 0 0 .22.368h12.164a.25.25 0 0 0 .22-.368Zm.53 3.996v2.5a.75.75 0 0 1-1.5 0v-2.5a.75.75 0 0 1 1.5 0ZM9 11a1 1 0 1 1-2 0 1 1 0 0 1 2 0Z"></path></svg>` },
        { key: "[!CAUTION]", cls: "callout-caution", title: "Caution", svg: `<svg class="callout-icon" viewBox="0 0 16 16" width="16" height="16" fill="currentColor"><path d="M4.47.22A.749.749 0 0 1 5 0h6c.199 0 .389.079.53.22l4.25 4.25c.141.14.22.33.22.53v6a.749.749 0 0 1-.22.53l-4.25 4.25A.749.749 0 0 1 11 16H5a.749.749 0 0 1-.53-.22L.22 11.53A.749.749 0 0 1 0 11V5c0-.199.079-.389.22-.53Zm.84 1.28L1.5 5.31v5.38l3.81 3.81h5.38l3.81-3.81V5.31L10.69 1.5ZM8 4a.75.75 0 0 1 .75.75v3.5a.75.75 0 0 1-1.5 0v-3.5A.75.75 0 0 1 8 4Zm0 7a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z"></path></svg>` },
      ];

      for (const t of types) {
        if (text.includes(t.key)) {
          bq.classList.add("callout-alert", t.cls);
          let cleanContent = text.replace(t.key, "").replace(/^(\s*<br\s*\/?>)+/gi, "");
          bq.innerHTML = `<div class="callout-header">${t.svg}<span>${t.title}</span></div>` + cleanContent;
          break;
        }
      }
    });

    // 3. Setup IntersectionObserver for Right Side Outline View
    const outlineLinks = document.querySelectorAll<HTMLAnchorElement>("#right-outline-nav .outline-link");
    if (!outlineLinks.length) return;

    const headingEls: HTMLElement[] = [];
    outlineLinks.forEach((link) => {
      const id = link.getAttribute("data-heading-id");
      if (id) {
        const el = document.getElementById(id);
        if (el) headingEls.push(el);
      }
    });

    if (!headingEls.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute("id");
            outlineLinks.forEach((link) => {
              if (link.getAttribute("data-heading-id") === id) {
                link.classList.add("active");
              } else {
                link.classList.remove("active");
              }
            });
          }
        });
      },
      { rootMargin: "-10% 0px -70% 0px", threshold: 0 }
    );

    headingEls.forEach((el) => observer.observe(el));
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupDocInteractive);
  } else {
    setupDocInteractive();
  }
</script>

<style>
  .doc-shell-container {
    max-width: 1440px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 280px 1fr 240px;
    gap: var(--space-32);
    padding: var(--space-32) var(--space-24);
    min-height: calc(100vh - 80px);
  }

  /* ── Left Navigation Sidebar (Zero Bullet Icons) ── */
  .doc-sidebar-left {
    position: sticky;
    top: 100px;
    height: calc(100vh - 120px);
    overflow-y: auto;
    padding-right: var(--space-12);
  }

  .sidebar-header-box {
    margin-bottom: var(--space-20);
  }

  .sidebar-section-pill {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 2px 8px;
    background: var(--nested-card-bg);
    color: var(--fg-dim);
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-8);
  }

  .sidebar-section-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--fg);
  }

  .sidebar-nav-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    list-style: none !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  /* Sidebar Category Accordion Group */
  .sidebar-category-group {
    margin-bottom: var(--space-16);
    border-radius: var(--radius-md);
  }

  .sidebar-category-group[open] .cat-arrow {
    transform: rotate(180deg);
  }

  .sidebar-category-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-8) var(--space-10);
    font-family: var(--font-mono);
    font-size: 0.725rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--fg-dim);
    cursor: pointer;
    user-select: none;
    transition: color 0.2s ease;
    list-style: none !important;
  }

  .sidebar-category-title::-webkit-details-marker {
    display: none !important;
  }

  .sidebar-category-title:hover {
    color: var(--fg);
  }

  .cat-label {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cat-badge {
    font-size: 0.65rem;
    padding: 1px 6px;
    border-radius: 10px;
    background: var(--nested-card-bg);
    color: var(--fg-dim);
    margin-right: 6px;
  }

  .cat-arrow {
    transition: transform 0.2s ease;
    color: var(--fg-dim);
  }

  .sidebar-category-items {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 6px;
    padding-left: 4px;
  }

  .sidebar-nav-item {
    display: block;
    padding: var(--space-12) var(--space-16);
    border-radius: var(--radius-md);
    background: var(--card-bg);
    border: var(--border);
    transition: all 0.2s ease;
    list-style: none !important;
    text-decoration: none !important;
    margin-bottom: 2px;
  }

  .sidebar-nav-item::before {
    content: none !important;
  }

  .sidebar-nav-item:hover {
    border-color: var(--fg-dim);
    background: var(--nested-card-bg);
  }

  .sidebar-nav-item.active {
    background: var(--action-bg);
    color: var(--action-fg);
    border-color: var(--action-bg);
  }

  .item-title-row {
    display: flex;
    align-items: center;
    margin-bottom: 6px;
  }

  .item-label {
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.4;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sidebar-nav-item.active .item-label {
    color: var(--action-fg) !important;
  }

  .item-meta-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 2px;
  }

  .type-badge {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    padding: 2px 6px;
    border-radius: 4px;
    background: var(--nested-card-bg);
    color: var(--fg-muted);
    letter-spacing: 0.02em;
  }

  .type-badge.mdx {
    background: rgba(56, 189, 248, 0.15);
    color: #38bdf8;
    font-weight: 600;
  }

  .sidebar-nav-item.active .type-badge {
    background: rgba(255, 255, 255, 0.2);
    color: var(--action-fg);
  }

  .profile-badge {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--fg-dim);
  }

  .sidebar-nav-item.active .profile-badge {
    color: rgba(255, 255, 255, 0.8);
  }

  /* ── Main Content Area ── */
  .doc-content-main {
    min-width: 0;
    padding-bottom: var(--space-64);
  }

  .doc-breadcrumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.775rem;
    color: var(--fg-dim);
    margin-bottom: var(--space-16);
  }

  .doc-breadcrumbs a:hover {
    color: var(--fg);
  }

  .doc-breadcrumbs .current {
    color: var(--fg);
    font-weight: 600;
  }

  .doc-main-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin-bottom: var(--space-12);
    line-height: 1.2;
  }

  .doc-tags-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: var(--space-16);
  }

