---
// FILE: src/components/ui/Badge.astro
// Purpose: Astrodeck UI Badge Component with variant indicators (stable, draft, normative, level-3, accent).

interface Props {
  variant?: "stable" | "draft" | "deprecated" | "normative" | "accent" | "outline";
  class?: string;
}

const { variant = "stable", class: className = "" } = Astro.props;

const variantStyles: Record<string, string> = {
  stable: "bg-emerald-500/10 text-emerald-400 border-emerald-500/30",
  draft: "bg-amber-500/10 text-amber-400 border-amber-500/30",
  deprecated: "bg-rose-500/10 text-rose-400 border-rose-500/30",
  normative: "bg-blue-500/10 text-blue-400 border-blue-500/30",
  accent: "bg-violet-500/10 text-violet-400 border-violet-500/30",
  outline: "bg-zinc-800/50 text-zinc-300 border-zinc-700",
};

const badgeStyle = variantStyles[variant] || variantStyles.stable;
---

<span class={`inline-flex items-center gap-1.5 px-2.5 py-0.5 text-xs font-medium rounded-full border transition-all ${badgeStyle} ${className}`}>
  <span class="w-1.5 h-1.5 rounded-full bg-current opacity-75"></span>
  <slot />
</span>
