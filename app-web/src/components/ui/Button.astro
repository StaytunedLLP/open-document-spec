---
// FILE: src/components/ui/Button.astro
// Purpose: Astrodeck Button Primitive supporting primary, secondary, ghost, and shimmer CTA styles.

interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "ghost" | "shimmer";
  size?: "sm" | "md" | "lg";
  target?: string;
  rel?: string;
  class?: string;
  id?: string;
}

const {
  href,
  variant = "primary",
  size = "md",
  target,
  rel,
  class: className = "",
  id,
} = Astro.props;

const sizeStyles = {
  sm: "px-3 py-1.5 text-xs font-medium",
  md: "px-4 py-2 text-sm font-semibold",
  lg: "px-6 py-3 text-base font-bold",
};

const variantStyles = {
  primary: "bg-emerald-500 hover:bg-emerald-400 text-zinc-950 shadow-lg shadow-emerald-500/20 active:scale-95",
  secondary: "bg-zinc-800 hover:bg-zinc-700 text-zinc-100 border border-zinc-700 active:scale-95",
  ghost: "bg-transparent hover:bg-zinc-800/60 text-zinc-300 hover:text-white",
  shimmer: "bg-gradient-to-r from-emerald-500 via-teal-400 to-emerald-500 text-zinc-950 shadow-xl shadow-emerald-500/25 hover:brightness-110 active:scale-95",
};

const baseStyles = "inline-flex items-center justify-center gap-2 rounded-xl transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-emerald-500/40";
const computedClasses = `${baseStyles} ${sizeStyles[size]} ${variantStyles[variant]} ${className}`;
---

{
  href ? (
    <a href={href} class={computedClasses} target={target} rel={rel} id={id}>
      <slot />
    </a>
  ) : (
    <button class={computedClasses} id={id}>
      <slot />
    </button>
  )
}
