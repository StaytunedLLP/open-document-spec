---
// FILE: src/components/ui/Card.astro
// Purpose: Astrodeck UI Card component with glassmorphism glow and border highlights.

interface Props {
  title?: string;
  description?: string;
  badge?: string;
  class?: string;
}

const { title, description, badge, class: className = "" } = Astro.props;
---

<div class={`relative group rounded-2xl bg-zinc-900/60 border border-zinc-800/80 p-6 backdrop-blur-xl transition-all duration-300 hover:border-emerald-500/40 hover:shadow-2xl hover:shadow-emerald-500/10 ${className}`}>
  {badge && (
    <div class="mb-3 inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
      {badge}
    </div>
  )}
  {title && (
    <h3 class="text-lg font-bold text-zinc-100 mb-2 group-hover:text-emerald-400 transition-colors">
      {title}
    </h3>
  )}
  {description && (
    <p class="text-sm text-zinc-400 leading-relaxed mb-4">
      {description}
    </p>
  )}
  <slot />
</div>
