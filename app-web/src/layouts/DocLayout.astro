---
// FILE: src/layouts/DocLayout.astro
// Purpose: Astrodeck-compatible layout wrapper for Documentation and Specification pages.

import DocShell from "../components/DocShell.astro";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface DocEntry {
  id: string;
  data: {
    title?: string;
    description?: string;
    status?: string;
    ods?: Record<string, any>;
    [key: string]: any;
  };
}

interface Props {
  collection: "docs" | "specs";
  currentEntry: DocEntry;
  allEntries: DocEntry[];
  Content: any;
  headings: Heading[];
}

const { collection, currentEntry, allEntries, Content, headings } = Astro.props;
---

<DocShell
  collection={collection}
  currentEntry={currentEntry}
  allEntries={allEntries}
  Content={Content}
  headings={headings}
/>
