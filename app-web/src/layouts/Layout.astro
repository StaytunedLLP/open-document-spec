---
// FILE: Layout.astro
// Purpose: Wraps marketing pages with shared metadata, top nav, and first-class mature footer styling.
// Layer: Marketing layout

import { REPO_URL } from "../lib/releases";

interface Props {
  title?: string;
  description?: string;
  activeNav?: string;
}

const {
  title = "Open Document Spec (ODS): Built to make your documentation extraordinarily productive",
  description = "Open Document Spec enriches plain Markdown repositories with machine-readable YAML frontmatter, explicit dependency graphs, and deterministic AI context loading.",
  activeNav = "home",
} = Astro.props;

const navItems = [
  { id: "home", label: "Home", href: "/" },
  { id: "features", label: "Features", href: "/features" },
  { id: "spec", label: "Spec", href: "/spec" },
  { id: "docs", label: "Docs", href: "/docs" },
  { id: "examples", label: "Examples", href: "/examples" },
  { id: "pricing", label: "Pricing", href: "/pricing" },
  { id: "changelog", label: "Changelog", href: "/changelog" },
];

const docsSubItems = [
  { label: "Overview & Guide Index", href: "/docs/index" },
  { label: "Introduction to ODS", href: "/docs/introduction" },
  { label: "Quickstart Guide", href: "/docs/quickstart" },
  { label: "Adopting ODS", href: "/docs/adoption" },
  { label: "Tooling Reference", href: "/docs/tooling" },
  { label: "Profiles & Catalogs", href: "/docs/profiles" },
  { label: "Advanced Workspaces", href: "/docs/advanced" },
  { label: "Troubleshooting Guide", href: "/docs/troubleshooting-and-diagnostics" },
  { label: "Enterprise Deployment", href: "/docs/enterprise-deployment" },
  { label: "Features & Architecture", href: "/docs/features" },
  { label: "ROI Calculator", href: "/docs/roi-calculator" },
  { label: "FAQ & Troubleshooting", href: "/docs/faq" },
  { label: "Enterprise Use Cases", href: "/docs/use-cases" },
];

const specSubItems = [
  { label: "ODS · Intro", href: "/spec/ods/intro" },
  { label: "ODS · Keys", href: "/spec/ods/keys" },
  { label: "ODS · Core", href: "/spec/ods/core" },
  { label: "ODS · Profiles", href: "/spec/ods/profiles" },
  { label: "ODS · Graph", href: "/spec/ods/graph" },
  { label: "ODS · Context", href: "/spec/ods/context" },
  { label: "ODS · Indexes", href: "/spec/ods/indexes" },
  { label: "ODS · Assets", href: "/spec/ods/assets" },
  { label: "ODS · Validation", href: "/spec/ods/validation" },
  { label: "ODS · Scope", href: "/spec/ods/scope" },
  { label: "OKF · Intro", href: "/spec/okf/intro" },
  { label: "Skills · Intro", href: "/spec/skills/intro" },
];

const canonicalURL = new URL(Astro.url.pathname, "https://opendocify.com").href;

const jsonLdOrg = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Staytuned LLP",
  "url": "https://opendocify.com",
  "logo": "https://opendocify.com/ods-logo.svg",
  "sameAs": ["https://github.com/StaytunedLLP/open-document-specs"],
  "areaServed": "Worldwide",
  "knowsAbout": [
    "Open Document Spec",
    "Markdown Specifications",
    "Graph Specifications",
    "AI Context Protocols",
    "Developer Tooling",
    "Local-First Architecture"
  ]
};

const jsonLdWebsite = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Open Document Spec (ODS)",
  "url": "https://opendocify.com",
  "description": description,
  "inLanguage": "en",
  "publisher": {
    "@type": "Organization",
    "name": "Staytuned LLP"
  }
};

const jsonLdApp = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Open Document Spec CLI (ods)",
  "operatingSystem": "macOS, Windows, Linux",
  "applicationCategory": "DeveloperApplication",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "license": "https://www.apache.org/licenses/LICENSE-2.0",
  "softwareVersion": "0.1.36"
};
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Generative Engine Optimization (GEO) & AI Discovery Protocol -->
    <link rel="help" href="https://opendocify.com/llms.txt" type="text/plain" />
    <meta name="ai-content-declaration" content="official-documentation" />

    <!-- Search Engine & Crawlers -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Geographic & Multilingual Metadata -->
    <meta property="og:locale" content="en_US" />
    <link rel="alternate" hreflang="x-default" href={canonicalURL} />
    <link rel="alternate" hreflang="en" href={canonicalURL} />
    <meta name="geo.region" content="US" />
    <meta name="geo.placename" content="Global" />

    <!-- OpenGraph / Facebook / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Open Document Spec (ODS)" />
    <meta property="og:image" content="https://opendocify.com/ods-logo.svg" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://opendocify.com/ods-logo.svg" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdOrg)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdWebsite)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdApp)} />

    <!-- Fonts & Favicons -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="/ods-logo.svg" type="image/svg+xml" />
    <script is:inline>
      (function() {
        const savedTheme = localStorage.getItem('ods-theme') || 'light';
        document.documentElement.setAttribute('data-theme', savedTheme);
      })();
    </script>
  </head>
  <body>
    <div class="page">
      <header class="nav-header">
        <nav class="nav">
          <div class="nav-left">
            <a href="/" class="nav-brand">
              <svg class="nav-icon" viewBox="-6 3 158 152" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M99 14C105.5 14 140.5 52 140.5 56H120C108.402 56 99 46.598 99 35V14Z" fill="currentColor"/>
                <path d="M6 106.443V35C6 23.402 15.402 14 27 14H99M99 14C105.5 14 140.5 52 140.5 56M99 14V35C99 46.598 108.402 56 120 56H140.5M140.5 56V106.443M52 92.5L28 115M73.5 103.5V144M94 92.5L118 115" stroke="currentColor" stroke-width="11" stroke-linecap="round"/>
                <circle cx="73" cy="80" r="12" fill="currentColor"/>
                <circle cx="12" cy="134" r="12" fill="currentColor"/>
                <circle cx="134" cy="134" r="12" fill="currentColor"/>
              </svg>
              <span class="nav-brand-text">
                <span class="brand-full">Open Docify</span>
                <span class="brand-short">ODS</span>
              </span>
              <span class="nav-badge">v0.1.x</span>
            </a>
          </div>

          <div class="nav-menu">
            {
              navItems.map((item) => (
                <a
                  href={item.href}
                  class:list={["nav-menu-item", { active: activeNav === item.id }]}
                >
                  {item.label}
                </a>
              ))
            }
          </div>

          <div class="nav-right">
            <button
              id="theme-toggle-btn"
              class="nav-theme-btn"
              title="Toggle Dark / Light Theme"
              aria-label="Toggle Theme"
            >
              <svg class="sun-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="5"></circle>
                <line x1="12" y1="1" x2="12" y2="3"></line>
                <line x1="12" y1="21" x2="12" y2="23"></line>
                <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                <line x1="1" y1="12" x2="3" y2="12"></line>
                <line x1="21" y1="12" x2="23" y2="12"></line>
                <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
              </svg>
              <svg class="moon-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
              </svg>
            </button>

            <!-- Hamburger Menu Button (visible on mobile only) -->
            <button
              id="nav-hamburger-btn"
              class="nav-hamburger-btn"
              title="Open Navigation Menu"
              aria-label="Open Navigation Menu"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
              </svg>
            </button>

            <a
              href="https://x.com/staytunedllp"
              target="_blank"
              rel="noopener noreferrer"
              class="nav-x-link"
              title="Follow ODS on X (Twitter)"
              aria-label="Follow ODS on X"
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </a>
            <a
              href={REPO_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="nav-github"
            >
              <span>GitHub</span>
              <span class="nav-github-arrow" aria-hidden="true">&#8599;</span>
            </a>
          </div>
        </nav>
      </header>

      <main class="main">
        <slot />
      </main>

      <!-- First-Class Mature Enterprise Footer -->
      <footer class="mature-footer">
        <div class="footer-top-grid">
          <!-- Brand Column -->
          <div class="footer-col brand-col">
            <a href="/" class="footer-brand-title">
              <svg class="footer-brand-icon" viewBox="-6 3 158 152" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M99 14C105.5 14 140.5 52 140.5 56H120C108.402 56 99 46.598 99 35V14Z" fill="currentColor"/>
                <path d="M6 106.443V35C6 23.402 15.402 14 27 14H99M99 14C105.5 14 140.5 52 140.5 56M99 14V35C99 46.598 108.402 56 120 56H140.5M140.5 56V106.443M52 92.5L28 115M73.5 103.5V144M94 92.5L118 115" stroke="currentColor" stroke-width="11" stroke-linecap="round"/>
                <circle cx="73" cy="80" r="12" fill="currentColor"/>
                <circle cx="12" cy="134" r="12" fill="currentColor"/>
                <circle cx="134" cy="134" r="12" fill="currentColor"/>
              </svg>
              <span>Open Docify</span>
            </a>
            <p class="footer-brand-desc">
              Human-First Document Graphs for Enterprise AI. Cutting prompt token usage by up to 94% with zero vendor lock-in.
            </p>
            <div class="status-indicator">
              <span class="status-dot"></span>
              <span>All Systems Operational</span>
            </div>
          </div>

          <!-- Product & Features Column -->
          <div class="footer-col">
            <h4 class="col-title">Product & Features</h4>
            <ul class="col-links">
              <li><a href="/features">All Features & Keys</a></li>
              <li><a href="/spec">Specification v0.1.0</a></li>
              <li><a href="/spec#levels">Conformance Levels 0–3</a></li>
              <li><a href="/docs">Native Rust CLI (<code>ods</code>)</a></li>
              <li><a href="/docs">Background OS Daemon</a></li>
            </ul>
          </div>

          <!-- Developer Docs & Industry Column -->
          <div class="footer-col">
            <h4 class="col-title">Docs & Use Cases</h4>
            <ul class="col-links">
              <li><a href="/docs/02-quickstart">Quickstart Installation</a></li>
              <li><a href="/docs/04-tooling">CLI Commands Reference</a></li>
              <li><a href="/examples">Industry Use Cases</a></li>
              <li><a href="/docs/02-quickstart">Claude Code AI Skill</a></li>
              <li><a href="/spec/ods/keys">Frontmatter Keys</a></li>
            </ul>
          </div>

          <!-- Pricing & Community Column -->
          <div class="footer-col">
            <h4 class="col-title">Resources & Pricing</h4>
            <ul class="col-links">
              <li><a href="/pricing">Community Core ($0 - Available)</a></li>
              <li><a href="/pricing">Pro Cloud (Coming Soon)</a></li>
              <li><a href="/pricing">Enterprise (Coming Soon)</a></li>
              <li><a href={REPO_URL} target="_blank" rel="noopener noreferrer">GitHub Repository ↗</a></li>
              <li><a href={`${REPO_URL}/issues`} target="_blank" rel="noopener noreferrer">Issue Tracker ↗</a></li>
              <li><a href="/changelog">Release Changelog</a></li>
            </ul>
          </div>
        </div>

        <!-- Bottom Copyright Bar -->
        <div class="footer-bottom-bar">
          <div class="copyright-text">
            &copy; {new Date().getFullYear()} Open Document Spec (ODS) Project. Released under the Apache 2.0 License.
          </div>
          <div class="legal-links">
            <a href={REPO_URL} target="_blank" rel="noopener noreferrer">GitHub</a>
            <span>•</span>
            <a href={`${REPO_URL}/blob/main/LICENSE`} target="_blank" rel="noopener noreferrer">Apache 2.0 License</a>
            <span>•</span>
            <a href="/privacy">Privacy & Secrets Policy</a>
          </div>
        </div>
      </footer>
    </div>

    <!-- Sidebar Drawer for Mobile Navigation -->
    <div id="nav-sidebar" class="nav-sidebar">
      <div class="sidebar-header">
        <span class="sidebar-brand">ODS</span>
        <button id="sidebar-close-btn" class="sidebar-close-btn" aria-label="Close Menu">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      <div class="sidebar-menu">
        {
          navItems.map((item) => {
            const isDocs = item.id === "docs";
            const isSpec = item.id === "spec";
            const subItems = isDocs ? docsSubItems : (isSpec ? specSubItems : null);

            if (!subItems) {
              return (
                <a
                  href={item.href}
                  class:list={["sidebar-menu-item", { active: activeNav === item.id }]}
                >
                  {item.label}
                </a>
              );
            }

            return (
              <details class="sidebar-menu-group" open={activeNav === item.id}>
                <summary class="sidebar-menu-summary">
                  <a
                    href={item.href}
                    class:list={["sidebar-menu-item-link", { active: activeNav === item.id }]}
                  >
                    {item.label}
                  </a>
                  <svg class="summary-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </summary>
                <div class="sidebar-sub-items">
                  {subItems.map((sub) => (
                    <a href={sub.href} class="sidebar-sub-link">
                      {sub.label}
                    </a>
                  ))}
                </div>
              </details>
            );
          })
        }
      </div>
      <div class="sidebar-footer">
        <a href={REPO_URL} target="_blank" rel="noopener noreferrer" class="sidebar-github-btn">
          <span>GitHub Repository</span>
          <span aria-hidden="true">&#8599;</span>
        </a>
      </div>
    </div>
    <div id="sidebar-overlay" class="sidebar-overlay"></div>

    <script>
      function setupThemeToggle() {
        const toggleBtn = document.getElementById('theme-toggle-btn');
        if (!toggleBtn) return;

        toggleBtn.addEventListener('click', () => {
          const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
          const newTheme = currentTheme === 'light' ? 'dark' : 'light';
          
          document.documentElement.setAttribute('data-theme', newTheme);
          localStorage.setItem('ods-theme', newTheme);
        });
      }

      function setupMobileMenu() {
        const hamburgerBtn = document.getElementById('nav-hamburger-btn');
        const closeBtn = document.getElementById('sidebar-close-btn');
        const sidebar = document.getElementById('nav-sidebar');
        const overlay = document.getElementById('sidebar-overlay');

        if (!hamburgerBtn || !sidebar || !overlay) return;

        function openMenu() {
          if (sidebar) sidebar.classList.add('open');
          if (overlay) overlay.classList.add('open');
          document.body.style.overflow = 'hidden';
        }

        function closeMenu() {
          if (sidebar) sidebar.classList.remove('open');
          if (overlay) overlay.classList.remove('open');
          document.body.style.overflow = '';
        }

        hamburgerBtn.addEventListener('click', openMenu);
        if (closeBtn) closeBtn.addEventListener('click', closeMenu);
        if (overlay) overlay.addEventListener('click', closeMenu);

        const sidebarLinks = sidebar.querySelectorAll('.sidebar-menu-item');
        sidebarLinks.forEach(link => {
          link.addEventListener('click', closeMenu);
        });
      }

        function setupCodeHighlighting() {
          const codeBlocks = document.querySelectorAll('.theme-code code, pre code, .ex-cmd code, .row-cmd code');
          codeBlocks.forEach(function(codeEl) {
            if (codeEl.getAttribute('data-highlighted') === 'true') return;

            var text = codeEl.textContent || '';
            if (!text.trim()) return;

            if (text.trim().startsWith('$')) {
              var parts = text.trim().split(/\s+/);
              var html = parts.map(function(part) {
                if (part === '$') return '<span class="tok-prompt">$</span>';
                if (part === 'ods' || part === 'cargo' || part === 'npm') return '<span class="tok-cmd">' + part + '</span>';
                if (part.startsWith('--')) return '<span class="tok-flag">' + part + '</span>';
                if (part.includes('/') || part.endsWith('.md') || part.endsWith('.rs') || part.endsWith('.proto') || part.endsWith('.csv')) return '<span class="tok-path">' + part + '</span>';
                return '<span class="tok-subcmd">' + part + '</span>';
              }).join(' ');
              codeEl.innerHTML = html;
            } else {
              var lines = text.split('\n');
              var highlightedLines = lines.map(function(line) {
                var trimmed = line.trim();
                if (trimmed === '---') {
                  return '<span class="tok-dash">---</span>';
                }
                if (line.startsWith('#')) {
                  return '<span class="tok-comment">' + line + '</span>';
                }
                
                var processedLine = line;
                
                processedLine = processedLine.replace(/^(\s*)([a-zA-Z0-9_\-]+:)(.*)/, function(_match: string, indent: string, key: string, rest: string) {
                  var keySpan = '<span class="tok-key">' + key + '</span>';
                  var restVal = rest;
                  
                  if (restVal.trim().endsWith('()')) {
                    restVal = restVal.replace(/([a-zA-Z0-9_]+\(\))/, '<span class="tok-fn">$1</span>');
                  } else if (restVal.includes('/')) {
                    restVal = restVal.replace(/([a-zA-Z0-9_\-\.\/]+)/g, '<span class="tok-path">$1</span>');
                  } else if (restVal.trim().length > 0) {
                    restVal = '<span class="tok-val">' + restVal + '</span>';
                  }
                  return indent + keySpan + restVal;
                });

                processedLine = processedLine.replace(/^(\s*-\s+)(.*)/, function(_match: string, bullet: string, item: string) {
                  var bulletSpan = '<span class="tok-bullet">' + bullet + '</span>';
                  var itemStr = item;
                  if (itemStr.includes(':')) {
                    itemStr = itemStr.replace(/([a-zA-Z0-9_\-]+:)(.*)/, function(_m: string, k: string, v: string) {
                      var kSpan = '<span class="tok-key">' + k + '</span>';
                      var vSpan = v.includes('/') ? '<span class="tok-path">' + v + '</span>' : '<span class="tok-val">' + v + '</span>';
                      return kSpan + vSpan;
                    });
                  } else if (itemStr.includes('/')) {
                    itemStr = '<span class="tok-path">' + itemStr + '</span>';
                  } else {
                    itemStr = '<span class="tok-val">' + itemStr + '</span>';
                  }
                  return bulletSpan + itemStr;
                });

                return processedLine;
              });

              codeEl.innerHTML = highlightedLines.join('\n');
            }

            codeEl.setAttribute('data-highlighted', 'true');
          });
        }

        function setupScrollAnimations() {
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            document.querySelectorAll('.reveal-on-scroll').forEach(function(el) {
              el.classList.add('is-revealed');
            });
            return;
          }

          var selectors = [
            '.hero-section',
            'section',
            '.reveal-on-scroll',
            '.feature-card',
            '.spec-card',
            '.doc-section',
            '.pricing-card',
            '.ex-card',
            '.changelog-item',
            '.faq-card',
            '.workflow-step-card',
            '.persona-card',
            '.metric-card',
            '.profile-card',
            '.p-card',
            '.ecosystem-card',
            '.comparison-card',
            '.banner-item',
            '.plan-card',
            '.guide-card',
            '.cmd-card',
            '.integration-card',
            '.comp-card',
            '.download-card',
            '.roi-card',
            '.m-card',
            '.pathway-col',
            '.cli-wrap',
            '.step-card',
            '.docs-card',
            '.spec-hero',
            '.features-hero'
          ];

          var elementsToObserve = new Set();

          selectors.forEach(function(selector) {
            document.querySelectorAll(selector).forEach(function(el) {
              if (el.closest('.nav-header') || el.closest('.mature-footer') || el.closest('.nav-sidebar')) {
                return;
              }
              elementsToObserve.add(el);
            });
          });

          var gridContainers = document.querySelectorAll('.grid, .features-grid, .spec-grid, .pricing-grid, .ex-grid, .cards-grid, .workflow-grid, .banner-grid, .plans-grid, .guide-grid, .comp-grid, .download-grid');
          gridContainers.forEach(function(container) {
            Array.from(container.children).forEach(function(child, idx) {
              if (!child.closest('.nav-header') && !child.closest('.mature-footer')) {
                (child as HTMLElement).style.setProperty('--reveal-index', String(Math.min(idx, 10)));
                elementsToObserve.add(child);
              }
            });
          });

          elementsToObserve.forEach(function(el) {
            var htmlEl = el as HTMLElement;
            if (!htmlEl.classList.contains('reveal-on-scroll')) {
              htmlEl.classList.add('reveal-on-scroll');
            }
          });

          var observer = new IntersectionObserver(function(entries) {
            entries.forEach(function(entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                observer.unobserve(entry.target);
              }
            });
          }, {
            threshold: 0.05,
            rootMargin: '0px 0px -30px 0px'
          });

          var viewportHeight = window.innerHeight;
          elementsToObserve.forEach(function(el) {
            var htmlEl = el as HTMLElement;
            var rect = htmlEl.getBoundingClientRect();
            if (rect.top < viewportHeight - 20 && rect.bottom > 0) {
              htmlEl.classList.add('is-revealed');
            } else {
              observer.observe(htmlEl);
            }
          });
        }

        function setupSmoothScroll() {
          document.addEventListener('click', function(e) {
            var target = e.target as HTMLElement | null;
            var anchor = target ? target.closest('a[href^="#"]') as HTMLAnchorElement | null : null;
            if (!anchor) return;

            var href = anchor.getAttribute('href');
            if (!href || href === '#') return;

            var targetEl = document.querySelector(href);
            if (targetEl) {
              e.preventDefault();
              var header = document.querySelector('.nav-header');
              var headerHeight = header ? header.getBoundingClientRect().height : 70;
              var targetPosition = targetEl.getBoundingClientRect().top + window.pageYOffset - (headerHeight + 16);

              window.scrollTo({
                top: targetPosition,
                behavior: 'smooth'
              });
            }
          }, { passive: false });
        }

        setupThemeToggle();
        setupMobileMenu();
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', function() {
            setupCodeHighlighting();
            setupScrollAnimations();
            setupSmoothScroll();
          });
        } else {
          setupCodeHighlighting();
          setupScrollAnimations();
          setupSmoothScroll();
        }
    </script>
