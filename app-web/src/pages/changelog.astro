---
// FILE: changelog.astro
// Purpose: Release changelog page for ODS.
// Layer: Marketing page

import Layout from "../layouts/Layout.astro";
import { REPO_URL } from "../lib/releases";
---

<Layout title="Changelog: Open Document Spec (ODS)" activeNav="changelog">
  <div class="page-container">
    <div class="header-section">
      <div class="pill-badge">Release History</div>
      <h1 class="page-title">Changelog</h1>
      <p class="page-subtitle">
        Latest updates, releases, performance improvements, and spec revisions for ODS.
      </p>
    </div>

    <div class="timeline">
      <div class="timeline-item">
        <div class="timeline-meta">
          <span class="version-tag">v0.1.0</span>
          <span class="date">Initial Release</span>
        </div>
        <div class="timeline-content">
          <h2>Open Document Specification Core Release</h2>
          <p>Initial release of ODS specification, Rust native CLI, and AI agent integration tools.</p>
          <ul>
            <li><strong>Rust Native Core</strong>: Ultra-fast <code>ods</code> binary for linting, indexing, and context extraction.</li>
            <li><strong>Level 0 to 3 Schema</strong>: Full support for <code>ods:</code> YAML frontmatter block, <code>depends</code>, and <code>related</code> edge graphs.</li>
            <li><strong>Deterministic Context CLI</strong>: Command <code>ods context &lt;path&gt;</code> to extract bounded dependency trees.</li>
            <li><strong>Background Daemon</strong>: Native watch mode auto-repairing file moves and links.</li>
            <li><strong>AI Agent Integrations</strong>: Native skills for Claude Code, Antigravity, Cursor, and Windsurf.</li>
          </ul>
        </div>
      </div>
    </div>

    <div class="changelog-cta">
      <a href={`${REPO_URL}/releases`} target="_blank" rel="noopener noreferrer" class="cta-button">
        View Full Release Logs on GitHub →
      </a>
    </div>
  </div>
</Layout>

<style>
  .page-container {
    width: min(92vw, 900px);
    margin: 0 auto;
    padding-top: var(--space-48);
    padding-bottom: var(--space-64);
  }

  .header-section {
    text-align: center;
    margin-bottom: var(--space-48);
  }

  .pill-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: var(--space-4) var(--space-12);
    background: var(--card-bg);
    border: var(--border);
    border-radius: var(--radius-pill);
    color: var(--fg-muted);
    margin-bottom: var(--space-16);
  }

  .page-title {
    font-size: clamp(2.4rem, 5.2vw, 3.4rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-16);
    color: var(--fg);
  }

  .page-subtitle {
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--fg-muted);
    max-width: 680px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .timeline {
    border-left: var(--border);
    padding-left: var(--space-32);
    margin-left: var(--space-16);
    margin-bottom: var(--space-64);
  }

  .timeline-item {
    position: relative;
    margin-bottom: var(--space-48);
  }

  .timeline-item::before {
    content: "";
    position: absolute;
    left: calc(-2rem - 5px);
    top: 6px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--fg);
  }

  .timeline-meta {
    display: flex;
    align-items: center;
    gap: var(--space-12);
    margin-bottom: var(--space-12);
  }

  .version-tag {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    padding: var(--space-4) var(--space-8);
    background: var(--action-bg);
    color: var(--action-fg);
    border-radius: var(--radius-sm);
  }

  .date {
    font-size: 0.8rem;
    color: var(--fg-dim);
  }

  .timeline-content h2 {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--fg);
    margin-bottom: var(--space-8);
  }

  .timeline-content p {
    font-size: 0.875rem;
    color: var(--fg-muted);
    line-height: 1.6;
    margin-bottom: var(--space-16);
  }

  .timeline-content ul {
    list-style-type: disc;
    padding-left: var(--space-24);
  }

  .timeline-content li {
    font-size: 0.85rem;
    color: var(--fg-muted);
    margin-bottom: var(--space-8);
    line-height: 1.5;
  }

  .timeline-content li strong {
    color: var(--fg);
  }

  .changelog-cta {
    text-align: center;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    padding: var(--space-12) var(--space-24);
    background: var(--action-bg);
    color: var(--action-fg);
    border-radius: var(--radius-pill);
    font-weight: 600;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    transition: opacity 0.2s ease;
  }

  .cta-button:hover {
    opacity: 0.9;
  }

  @media (max-width: 640px) {
    .timeline-item {
      grid-template-columns: 1fr;
      gap: var(--space-12);
    }
    .timeline-meta {
      flex-direction: row;
      align-items: center;
      gap: var(--space-8);
    }
    .main {
      padding: var(--space-32) var(--space-16) var(--space-48);
    }
  }
</style>
