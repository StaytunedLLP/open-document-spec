---
// FILE: src/pages/docs.astro
// Purpose: Main /docs route rendering the default user guide in the MDX DocShell.

import { getCollection, render } from "astro:content";
import DocShell from "../components/DocShell.astro";

const allEntries = await getCollection("docs");
const sortedEntries = [...allEntries].sort((a, b) => {
  const idA = a.id || "";
  const idB = b.id || "";
  if (idA.includes("01")) return -1;
  if (idB.includes("01")) return 1;
  return idA.localeCompare(idB);
});

const defaultEntry = sortedEntries[0];
const { Content, headings } = await render(defaultEntry);
---

<DocShell
  collection="docs"
  currentEntry={defaultEntry}
  allEntries={allEntries}
  Content={Content}
  headings={headings}
/>
