---
// FILE: src/pages/docs/[...slug].astro
// Purpose: Dynamic route rendering MDX / MD user guides in content/docs collection inside the site shell. Supports both extensionless and .md/.mdx URLs.

import { getCollection, render } from "astro:content";
import DocShell from "../../components/DocShell.astro";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  const paths: Array<{ params: { slug: string }; props: { entry: any } }> = [];

  docs.forEach((entry) => {
    const cleanSlug = entry.id.replace(/\.(md|mdx)$/, "");
    paths.push({
      params: { slug: cleanSlug },
      props: { entry },
    });

    if (entry.id !== cleanSlug) {
      paths.push({
        params: { slug: entry.id },
        props: { entry },
      });
    }
  });

  return paths;
}

const { entry } = Astro.props;
const allEntries = await getCollection("docs");
const { Content, headings } = await render(entry);
---

<DocShell
  collection="docs"
  currentEntry={entry}
  allEntries={allEntries}
  Content={Content}
  headings={headings}
/>
