---
// FILE: download.astro
// Purpose: Download ODS CLI binaries and skills for macOS, Windows, or Linux.
// Layer: Marketing page

import PlatformIcon from "../components/PlatformIcon.astro";
import Layout from "../layouts/Layout.astro";
import { RELEASES_URL } from "../lib/releases";
---

<Layout title="Download ODS CLI: Open Document Spec" description="Download ODS CLI and Skills for macOS, Windows, or Linux.">
  <h1 class="heading">Download ODS CLI</h1>
  <p class="subheading">
    <span id="version-label">v0.1.0 release</span>
    <a id="changelog-link" class="changelog-link" href="/changelog">View changelog<span aria-hidden="true"> &#8599;</span></a>
  </p>

  <div class="platforms" id="platforms">
    <!-- macOS -->
    <section class="platform-section">
      <div class="platform-header">
        <PlatformIcon platform="apple" class="platform-icon" />
        <h2 class="platform-name">macOS</h2>
      </div>
      <div class="download-cards">
        <a class="download-card" data-asset="apple-darwin.tar.gz" href={RELEASES_URL}>
          <span class="card-arch">Apple Silicon / Intel (Rust Native)</span>
          <span class="card-format">ods binary</span>
        </a>
      </div>
    </section>

    <!-- Windows -->
    <section class="platform-section">
      <div class="platform-header">
        <PlatformIcon platform="windows" class="platform-icon" />
        <h2 class="platform-name">Windows</h2>
      </div>
      <div class="download-cards">
        <a class="download-card" data-asset="pc-windows-msvc.zip" href={RELEASES_URL}>
          <span class="card-arch">Windows x64</span>
          <span class="card-format">ods.exe</span>
        </a>
      </div>
    </section>

    <!-- Linux -->
    <section class="platform-section">
      <div class="platform-header">
        <PlatformIcon platform="linux" class="platform-icon" />
        <h2 class="platform-name">Linux</h2>
      </div>
      <div class="download-cards">
        <a class="download-card" data-asset="unknown-linux-gnu.tar.gz" href={RELEASES_URL}>
          <span class="card-arch">Linux x64</span>
          <span class="card-format">ods binary</span>
        </a>
      </div>
    </section>
  </div>

  <p class="releases-link">
    Looking for source code or building from source? Check the
    <a href={RELEASES_URL} target="_blank" rel="noopener noreferrer">
      GitHub releases page<span aria-hidden="true"> &#8599;</span>
    </a>
  </p>
</Layout>

<style>
  .main {
    padding: var(--space-48) var(--space-24) var(--space-64);
  }

  .heading {
    font-weight: 600;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    letter-spacing: -0.035em;
    line-height: 1.15;
    text-align: center;
    margin-bottom: var(--space-8);
    color: var(--fg);
    opacity: 0;
    animation: fade-in 1s ease-out forwards;
  }

  .subheading {
    font-size: 0.9rem;
    color: var(--fg-dim);
    margin-bottom: var(--space-48);
    opacity: 0;
    animation: fade-in 1s ease-out 0.1s forwards;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-12);
  }

  .changelog-link {
    color: var(--fg-muted);
    font-size: 0.8rem;
    text-decoration: underline;
    text-decoration-color: var(--border-color);
    text-underline-offset: 3px;
    transition: color 0.3s ease;
  }

  .changelog-link:hover {
    color: var(--fg);
  }

  .platforms {
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-32);
    opacity: 0;
    animation: fade-in 1s ease-out 0.2s forwards;
  }

  .platform-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .platform-header {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    padding-bottom: var(--space-8);
    border-bottom: var(--border);
  }

  .platform-icon {
    width: 1.15em;
    height: 1.15em;
    color: var(--fg-muted);
    flex-shrink: 0;
  }

  .platform-name {
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--fg);
  }

  .download-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  .download-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-12) var(--space-16);
    border-radius: var(--radius-md);
    border: var(--border);
    background: var(--card-bg);
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .download-card:hover {
    background: var(--nested-card-bg);
    border-color: var(--fg-dim);
  }

  .card-arch {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--fg);
  }

  .card-format {
    font-size: 0.8rem;
    color: var(--fg-dim);
  }

  .releases-link {
    margin-top: var(--space-48);
    font-size: 0.825rem;
    color: var(--fg-dim);
    text-align: center;
    opacity: 0;
    animation: fade-in 1s ease-out 0.35s forwards;
  }

  .releases-link a {
    color: var(--fg-muted);
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .main {
      padding: var(--space-32) var(--space-16) var(--space-48);
    }
  }
</style>
