---
// FILE: examples.astro
// Purpose: Industry Use Cases & Examples Page with Top Category Filter Bar and 16+ Real-World Industry Examples.
// Layer: Marketing page

import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { REPO_URL } from "../lib/releases";

const categories = [
  { id: "all", label: "All Examples" },
  { id: "coding", label: "Coding & Tech" },
  { id: "pharma", label: "Pharma & Health" },
  { id: "research", label: "Research & Academia" },
  { id: "legal", label: "Enterprise & Legal" },
  { id: "engineering", label: "Engineering & Aerospace" },
  { id: "design", label: "Design Systems" },
  { id: "devops", label: "DevOps & Cloud" },
  { id: "government", label: "Government & Policy" },
  { id: "fintech", label: "Finance & Fintech" },
];
---

<Layout title="16+ Industry Use Cases & Examples: Open Document Spec (ODS)" activeNav="examples">
  <!-- Background Dot Matrix Graphic -->
  <div class="dot-matrix-bg"></div>

  <div class="page-container">
    <div class="header-section">
      <div class="pill-badge">16+ Real-World Industry Use Cases</div>
      <h1 class="page-title">ODS Across All Knowledge Domains</h1>
      <p class="page-subtitle">
        How different teams adopt ODS to keep their documents updated and reduce AI assistant costs by up to 94%.
      </p>
    </div>

    <!-- Top Category Filter Pill Bar -->
    <div class="category-filter-bar">
      {categories.map((cat) => (
        <button
          class:list={["filter-btn", { active: cat.id === "all" }]}
          data-category={cat.id}
        >
          {cat.label}
        </button>
      ))}
    </div>

    <!-- Industry ROI Cost Reduction Summary Chart -->
    <div class="industry-roi-chart-box glow-card">
      <div class="roi-chart-header">
        <h4>Estimated Industry Cost Savings</h4>
        <span class="roi-badge">16 Team Use Cases</span>
      </div>
      <div class="roi-grid">
        <div class="roi-col">
          <span class="r-name">Coding & Tech</span>
          <div class="r-bar-track">
            <div class="r-bar-fill" style="width: 94.97%;">
              <span class="r-bar-text">94.97%</span>
            </div>
          </div>
        </div>
        <div class="roi-col">
          <span class="r-name">Pharma & Health</span>
          <div class="r-bar-track">
            <div class="r-bar-fill" style="width: 92.40%;">
