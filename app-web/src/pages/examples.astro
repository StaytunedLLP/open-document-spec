            <div class="r-bar-fill" style="width: 98.20%;">
              <span class="r-bar-text">98.20%</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content: 16+ Wide Horizontal Example Cards -->
    <div class="examples-content-grid">

      <!-- 1. Software Monorepos -->
      <div class="example-card-horizontal glow-card" data-category="coding">
        <div class="card-left">
          <div class="ex-header">
            <Icon name="code" size={20} class="ex-icon" />
            <div>
              <span class="ex-industry-tag">Coding & Tech</span>
              <h3>Connecting Design Decisions to Code</h3>
            </div>
          </div>
          <p class="ex-desc">
            Software teams connect system design notes directly to specific functions and variables in their program files.
          </p>
          <div class="ex-stats">
            <div class="stat-item">
              <span class="stat-val">94.97%</span>
              <span class="stat-lbl">Word Savings</span>
            </div>
            <div class="stat-item">
              <span class="stat-val">$34,800</span>
              <span class="stat-lbl">Annual Savings (10 Developers)</span>
            </div>
          </div>
          <div class="ex-cmd">
            <code>$ ods context docs/architecture/storage-engine.md</code>
          </div>
        </div>
        <div class="card-right">
          <div class="ex-code-box">
            <div class="code-title">docs/architecture/storage-engine.md</div>
