---
// FILE: features.astro
// Purpose: ods-Style Product Feature Showcase with Alternating Zig-Zag Sections & Interspersed Pareto Highlights.
// Layer: Marketing page

import Layout from "../layouts/Layout.astro";
import AIIcon from "../components/AIIcon.astro";
import Icon from "../components/Icon.astro";
import { REPO_URL } from "../lib/releases";
---

<Layout title="All Core Features: Open Document Spec (ODS)" activeNav="features">
  <div class="dot-matrix-bg"></div>

  <div class="page-container">
    <div class="header-section">
      <div class="pill-badge">Complete Product Capability Showcase</div>
      <h1 class="page-title">ODS Product Features</h1>
      <p class="page-subtitle">
        Discover how Open Document Spec adds simple labels to your text files (.md) and connects them together so AI assistants can find what they need instantly.
      </p>
    </div>

    <!-- TOP CORE FEATURE #1 (HERO HIGHLIGHT) -->
    <section class="feature-hero-top glow-card">
      <div class="hero-feat-left">
        <span class="pill-badge-sm">Featured Capability</span>
        <h2>Smart AI Reading Lists</h2>
        <p>
          Gives your AI assistant only the exact documents linked to your files, avoiding massive folder dumps. This speeds up answers and cuts AI usage costs by <strong>up to 94.97%</strong>.
        </p>
        <div class="hero-feat-metrics">
          <div class="m-card">
            <span class="m-val">~94%</span>
            <span class="m-lbl">Lower AI Cost</span>
          </div>
          <div class="m-card">
            <span class="m-val">4,100</span>
            <span class="m-lbl">Exact Words Sent</span>
          </div>
          <div class="m-card">
            <span class="m-val">&lt; 5ms</span>
            <span class="m-lbl">Document Scan</span>
          </div>
        </div>
        <div class="hero-cmd-box">
          <code>$ ods context docs/guide/01-introduction.md</code>
        </div>
      </div>

      <div class="hero-feat-right">
        <div class="code-box-wrapper">
          <div class="code-box-title">Linked Document Reading List</div>
          <pre class="theme-code"><code>Smart Reading List for [01-introduction.md]:
├── docs/guide/01-introduction.md (Main page)
├── specs/ods/intro.md (linked page)
├── docs/guide/05-profiles.md (related page)
└── src/crates/ods-core/src/graph.rs (connected code)

✓ Total Context: 4,120 words (saves 94.97% compared to reading all documents)
✓ Annual Savings: 94.97% less cost</code></pre>
        </div>
      </div>
    </section>

    <!-- ALTERNATING ROW PAIR 1 -->
    <div class="feature-rows-group">
      <!-- Feature Row 1 (Text Left, Code Right) -->
      <section class="feature-row glow-card">
        <div class="row-text">
          <span class="row-tag">Code Connections</span>
          <h3>Connecting Code to Documents</h3>
          <p>
            Link your text pages directly to specific functions, rules, or testing files inside your program code.
          </p>
          <div class="row-cmd">
            <code>$ ods context src/storage/db.rs</code>
          </div>
        </div>
        <div class="row-visual">
          <div class="code-box-wrapper">
            <div class="code-box-title">docs/architecture/storage.md</div>
            <pre class="theme-code"><code>---
ods:
  profile: spec
  code:
    - path: src/storage/db.rs
      symbol: init_pool()
      role: implementation
    - path: tests/db_test.rs
      role: test
---</code></pre>
          </div>
        </div>
      </section>

      <!-- Feature Row 2 (Code Left, Text Right: REVERSE) -->
      <section class="feature-row reverse glow-card">
        <div class="row-text">
          <span class="row-tag">Open Standard</span>
          <h3>Works with Standard Text Files</h3>
          <p>
            No hidden databases or complex formats. ODS works on top of simple, standard text files (.md) with clean labels at the top. You own your files forever.
          </p>
          <div class="row-cmd">
            <code>$ ods init</code>
          </div>
        </div>
        <div class="row-visual">
          <div class="code-box-wrapper">
            <div class="code-box-title">Root index.md</div>
            <pre class="theme-code"><code>---
ods: 0.1
ods: ">=0.0.8"
profiles:
  - spec
  - guide
---
# Workspace Index Tree</code></pre>
          </div>
        </div>
      </section>
    </div>

    <!-- CORE HIGHLIGHT #1 (AUTO-HEALING DAEMON) -->
    <section class="feature-big-banner glow-card">
      <div class="big-banner-header">
        <span class="banner-badge">Smart Link Repair</span>
        <h2>Automatic Link Repair Background Tool</h2>
        <p>Never break a link when you rename files, restructure folders, or change project layouts.</p>
      </div>

      <div class="big-banner-grid">
        <div class="banner-item">
          <div class="banner-item-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
              <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
            </svg>
          </div>
          <h4>Instant Link Updates</h4>
          <p>Renaming or moving document files automatically updates all connections and links in other files across your folder.</p>
        </div>

        <div class="banner-item">
          <div class="banner-item-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
            </svg>
          </div>
          <h4>Automatic Background Checker</h4>
          <p>A fast helper utility listens to file changes in the background and keeps your links up to date instantly.</p>
        </div>

        <div class="banner-item">
          <div class="banner-item-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <path d="m9 12 2 2 4-4"></path>
            </svg>
          </div>
          <h4>Error Checking on Save</h4>
          <p>Run the checker tool in your save workflow to detect broken document links or missing required sections automatically.</p>
        </div>
      </div>
    </section>

    <!-- ALTERNATING ROW PAIR 2 -->
    <div class="feature-rows-group">
      <!-- Feature Row 3 (Text Left, Visual Right) -->
      <section class="feature-row glow-card">
        <div class="row-text">
          <span class="row-tag">AI Tool Support</span>
          <h3>Works Natively with AI Tools</h3>
          <p>
            Plugs straight into Claude Code, Antigravity, Cursor, Windsurf, and other AI systems as a helper skill.
          </p>
          <div class="row-cmd">
            <code>$ ods context --json</code>
          </div>
        </div>
        <div class="row-visual">
          <div class="ai-chips-box">
            <div class="ai-chip-item"><AIIcon name="claude" size={24} /> <span>Claude Code</span></div>
            <div class="ai-chip-item"><AIIcon name="antigravity" size={24} /> <span>Antigravity</span></div>
            <div class="ai-chip-item"><AIIcon name="cursor" size={24} /> <span>Cursor</span></div>
            <div class="ai-chip-item"><AIIcon name="windsurf" size={24} /> <span>Windsurf</span></div>
          </div>
        </div>
      </section>

      <!-- Feature Row 4 (Visual Left, Text Right: REVERSE) -->
      <section class="feature-row reverse glow-card">
        <div class="row-text">
          <span class="row-tag">Gradual Adoption</span>
          <h3>Simple Adoption Steps</h3>
          <p>
            Adopt ODS at your own pace: from zero-setup plain Markdown (Level 0) to mapped document boundaries (Level 1), standard templates and labels (Level 2), and automated link verification (Level 3).
          </p>
          <div class="row-cmd">
            <code>$ ods index --check</code>
          </div>
        </div>
        <div class="row-visual">
          <div class="levels-mini-stack">
            <div class="l-step"><span>L0</span> Standard text files</div>
            <div class="l-step"><span>L1</span> Mapped document boundaries</div>
            <div class="l-step"><span>L2</span> Standard templates & labels</div>
            <div class="l-step active"><span>L3</span> Automated link verification</div>
          </div>
        </div>
      </section>
    </div>

    <!-- CORE HIGHLIGHT #2 (ENTERPRISE PROFILES) -->
    <section class="feature-big-banner glow-card section-ods-templates">
      <div class="big-banner-header">
        <span class="banner-badge">Document Organization</span>
        <h2>ODS Templates: Simple Document Structure</h2>
        <p>Keep your documents consistent and organized without manual formatting debates.</p>
      </div>

      <div class="profiles-section-wrapper">
        <div class="profiles-2x2-grid">
          <!-- Card 1: Technical Specs -->
          <div class="p-card">
            <span class="p-badge">profile: spec</span>
            <h4>Technical Specs</h4>
            <div class="headings-group">
              <span class="headings-label">Required Headings</span>
              <div class="heading-tags">
                <code class="h-tag">## Summary</code>
                <code class="h-tag">## Requirements</code>
                <code class="h-tag">## Schema</code>
              </div>
            </div>
          </div>

          <!-- Card 2: Runbooks & Guides -->
          <div class="p-card">
            <span class="p-badge">profile: guide</span>
            <h4>Runbooks & Guides</h4>
            <div class="headings-group">
              <span class="headings-label">Required Headings</span>
              <div class="heading-tags">
                <code class="h-tag">## Overview</code>
                <code class="h-tag">## Prerequisites</code>
                <code class="h-tag">## Steps</code>
              </div>
            </div>
          </div>

          <!-- Card 3: Product PRDs -->
          <div class="p-card">
            <span class="p-badge">profile: feature</span>
            <h4>Product PRDs</h4>
            <div class="headings-group">
              <span class="headings-label">Required Headings</span>
              <div class="heading-tags">
                <code class="h-tag">## User Goal</code>
                <code class="h-tag">## Acceptance Criteria</code>
              </div>
            </div>
          </div>

          <!-- Card 4: ADRs & Decision Notes -->
          <div class="p-card">
            <span class="p-badge">profile: note</span>
            <h4>ADRs & Decision Notes</h4>
            <div class="headings-group">
              <span class="headings-label">Required Headings</span>
              <div class="heading-tags">
                <code class="h-tag">## Context</code>
                <code class="h-tag">## Decision</code>
                <code class="h-tag">## Impact</code>
              </div>
            </div>
          </div>
        </div>

        <!-- Custom Template Card -->
        <div class="p-card custom-featured-card">
          <div class="custom-card-header">
            <span class="p-badge">profile: custom-security-audit</span>
            <h4>100% Custom Document Templates</h4>
          </div>
          <div class="headings-group">
            <span class="headings-label">Custom Required Sections</span>
            <div class="heading-tags">
              <code class="h-tag">## Executive Summary</code>
              <code class="h-tag">## Threat Model</code>
              <code class="h-tag">## Audit Findings</code>
            </div>
          </div>
        </div>
      </div>

      <!-- Level 0 to 3 Conformance Ladder Progress Graphic -->
      <div class="ladder-graphic-box">
        <h4 class="ladder-title">Simple Adoption Steps</h4>
        <div class="ladder-timeline">
          <div class="timeline-step">
            <span class="step-badge">Level 0</span>
            <h5 class="l-lbl">Plain Markdown (Zero Setup)</h5>
            <p>Use existing .md files as-is with zero changes</p>
          </div>

          <div class="timeline-step">
            <span class="step-badge">Level 1</span>
            <h5 class="l-lbl">Mapped document boundaries</h5>
            <p>Root index.md & tags</p>
          </div>

          <div class="timeline-step step-active">
            <span class="step-badge active-badge">Level 2</span>
            <h5 class="l-lbl">Standard templates & labels</h5>
            <p>Profiles & code symbols</p>
          </div>

          <div class="timeline-step">
            <span class="step-badge">Level 3</span>
            <h5 class="l-lbl">Automated link verification</h5>
            <p>Instant document scans</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ALTERNATING ROW PAIR 3 -->
    <div class="feature-rows-group">
      <!-- Feature Row 5 (Text Left, Code Right) -->
      <section class="feature-row glow-card">
        <div class="row-text">
          <span class="row-tag">Onboard Existing Folders</span>
          <h3>Import Existing Files in Seconds</h3>
          <p>
            Import your existing text files in seconds. The <code>ods adopt</code> tool automatically sets up labels for all your files so you don't have to edit them manually.
          </p>
          <div class="row-cmd">
            <code>$ ods adopt docs/</code>
          </div>
        </div>
        <div class="row-visual">
          <div class="code-box-wrapper">
            <div class="code-box-title">CLI Terminal Log</div>
            <pre class="theme-code"><code>$ ods adopt docs/
✓ Scanned 148 Markdown files
✓ Generated document templates and labels
✓ Created root project index</code></pre>
          </div>
        </div>
      </section>

      <!-- Feature Row 6 (Code Left, Text Right: REVERSE) -->
      <section class="feature-row reverse glow-card">
        <div class="row-text">
          <span class="row-tag">Better Than Vector Search</span>
          <h3>Hallucination-Free Reading Lists</h3>
          <p>
            Avoid expensive search database hosting and errors. ODS delivers highly accurate reading lists to your AI by using the direct connections you specify.
          </p>
          <div class="row-cmd">
            <code>$ ods graph --format dot</code>
          </div>
        </div>
        <div class="row-visual">
          <div class="rag-vs-box">
            <div class="rag-bad">❌ Vector Search: 80,000 words (scrambled snippets)</div>
            <div class="ods-good">✓ ODS Map: 4,100 words (instant linked pages)</div>
          </div>
        </div>
      </section>
    </div>

    <!-- CORE HIGHLIGHT #3 (SOC2 PRIVACY SHIELD) -->
    <section class="feature-big-banner glow-card">
      <div class="big-banner-header">
        <span class="banner-badge">Privacy & Security</span>
        <h2>Keep Sensitive Data Secure</h2>
        <p>Built-in controls to prevent private data or secret keys from leaking to external AI tools.</p>
      </div>

      <div class="big-banner-grid">
        <div class="banner-item">
          <div class="banner-item-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </div>
          <h4>Private File Filters</h4>
          <p>Pages marked with <code>share: private</code> are hidden and never sent to AI tools.</p>
        </div>

        <div class="banner-item">
          <div class="banner-item-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
              <line x1="1" y1="1" x2="23" y2="23"></line>
            </svg>
          </div>
          <h4>Inline Secret Blurring</h4>
          <p>Secrets placed inside secret labels are automatically stripped out before sending to AI tools.</p>
        </div>

        <div class="banner-item">
          <div class="banner-item-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 2v6h-6"></path>
              <path d="M3 12a9 9 0 0 1 15-6.7L21 8"></path>
              <path d="M3 22v-6h6"></path>
              <path d="M21 12a9 9 0 0 1-15 6.7L3 16"></path>
            </svg>
          </div>
          <h4>Settings Backup & Restore</h4>
          <p>Use the backup and restore tools to quickly clean or restore your files before sharing them.</p>
        </div>
      </div>
    </section>

    <!-- ALTERNATING ROW PAIR 4 -->
    <div class="feature-rows-group">
      <!-- Feature Row 7 (Text Left, Code Right) -->
      <section class="feature-row glow-card">
        <div class="row-text">
          <span class="row-tag">Cost Savings Stats</span>
          <h3>View Your Savings Stats</h3>
          <p>
            View estimated savings and cost reductions across your team using the built-in stats command.
          </p>
          <div class="row-cmd">
            <code>$ ods bench stats</code>
          </div>
        </div>
        <div class="row-visual">
          <div class="code-box-wrapper">
            <div class="code-box-title">ods bench stats</div>
            <pre class="theme-code"><code>$ ods bench stats
✓ Workspace Files: 240 docs
✓ Word Savings: 94.97%
✓ Estimated Annual Savings: $34,800</code></pre>
          </div>
        </div>
      </section>

      <!-- Feature Row 8 (Code Left, Text Right: REVERSE) -->
      <section class="feature-row reverse glow-card">
        <div class="row-text">
          <span class="row-tag">Label Management</span>
          <h3>Update Labels in Bulk</h3>
          <p>
            Search, filter, and rename labels across all your documents with a single quick command.
          </p>
          <div class="row-cmd">
            <code>$ ods tag rename old-tag new-tag</code>
          </div>
        </div>
        <div class="row-visual">
          <div class="code-box-wrapper">
            <div class="code-box-title">Bulk Label Rename</div>
            <pre class="theme-code"><code>$ ods tag rename deprecated legacy
✓ Updated 38 files in 12ms</code></pre>
          </div>
        </div>
      </section>
    </div>

    <!-- CTA & Key Reference Redirection Section -->
    <div class="features-bottom-cta glow-card">
      <div class="cta-left">
        <h2>Want to see the technical details?</h2>
        <p>All standard labels, properties, and terminal command flags are documented in the developer guides.</p>
      </div>
      <div class="cta-btns">
        <a href="/docs/features" class="primary-btn">View Developer Dictionary →</a>
        <a href={REPO_URL} target="_blank" rel="noopener noreferrer" class="secondary-btn">GitHub Repository ↗</a>
      </div>
    </div>

  </div>
</Layout>

<style>
  .page-container {
    width: min(94vw, 1200px);
    margin: 0 auto;
    padding-top: var(--space-48);
    padding-bottom: var(--space-64);
    position: relative;
    z-index: 1;
  }

  .header-section {
    text-align: center;
    max-width: 820px;
    margin: 0 auto var(--space-32);
  }

  .pill-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: var(--space-4) var(--space-12);
    background: var(--card-bg);
    border: var(--border);
    border-radius: var(--radius-pill);
    color: var(--fg-muted);
    margin-bottom: var(--space-16);
  }

  .page-title {
    font-size: clamp(2.4rem, 5.2vw, 3.4rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--fg);
    margin-bottom: var(--space-16);
    line-height: 1.15;
  }

  .page-subtitle {
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--fg-muted);
    line-height: 1.6;
  }

  /* ── TOP PARETO HERO FEATURE ── */

  .feature-hero-top {
    background: var(--card-bg);
    border: var(--border);
    border-radius: var(--radius-xl);
    padding: var(--space-48) var(--space-32);
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: var(--space-32);
    align-items: center;
    margin-bottom: var(--space-64) !important;
  }

  .pill-badge-sm {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    padding: var(--space-4) var(--space-8);
    background: var(--action-bg);
    color: var(--action-fg);
    border-radius: var(--radius-pill);
    display: inline-block;
    margin-bottom: var(--space-16);
  }

  .hero-feat-left h2 {
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--fg);
    margin-bottom: var(--space-12);
    line-height: 1.2;
  }

  .hero-feat-left p {
    font-size: 0.95rem;
    color: var(--fg-muted);
    line-height: 1.6;
    margin-bottom: var(--space-24);
  }

  .hero-feat-metrics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-16);
    margin-bottom: var(--space-24);
  }

  .m-card {
    background: var(--nested-card-bg);
    border: var(--border);
    padding: var(--space-8) var(--space-12);
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
  }

  .m-val {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--fg);
  }

  .m-lbl {
    font-size: 0.7rem;
    color: var(--fg-dim);
  }

  .hero-cmd-box {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    background: var(--nested-card-bg);
    padding: var(--space-12) var(--space-16);
    border-radius: var(--radius-sm);
    border: var(--border);
    color: var(--fg);
    overflow-x: auto;
    white-space: nowrap;
    max-width: 100%;
  }

  /* ── ALTERNATING FEATURE ROWS (ZIG-ZAG) ── */

  .feature-rows-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-28);
    margin-bottom: var(--space-64) !important;
  }

  .feature-row {
    background: var(--card-bg);
    border: var(--border);
    border-radius: var(--radius-xl);
    padding: var(--space-48) var(--space-32);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-32);
    align-items: center;
    margin-bottom: 0 !important;
  }

  .feature-row.reverse {
    grid-template-columns: 1fr 1fr;
  }

  .feature-row.reverse .row-text {
    order: 2;
  }

  .feature-row.reverse .row-visual {
    order: 1;
  }

  .row-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--fg-dim);
    display: block;
    margin-bottom: var(--space-4);
  }

  .row-text h3 {
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--fg);
    margin-bottom: var(--space-8);
  }

  .row-text p {
