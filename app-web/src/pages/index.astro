              </g>

              <!-- Dashed lines down from pages to AI -->
              <path d="M120 96 L160 134" stroke="#10b981" stroke-width="2" stroke-dasharray="4 4"/>
              <path d="M200 96 L160 134" stroke="#10b981" stroke-width="2" stroke-dasharray="4 4"/>

              <!-- Circle AI node -->
              <circle cx="160" cy="154" r="20" fill="var(--card-bg)" stroke="#10b981" stroke-width="2"/>
              <text x="160" y="159" fill="#10b981" font-family="Inter, sans-serif" font-size="13" font-weight="700" text-anchor="middle">AI</text>
            </svg>
          </div>

          <!-- Metrics Table -->
          <div class="exact-metrics-table">
            <div class="exact-row">
              <div class="row-left">
                <span class="icon-circle"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg></span>
                <span class="row-title">Pages Read</span>
              </div>
              <div class="row-right">
                <span class="num green">2</span>
                <span class="unit">Pages</span>
              </div>
            </div>

