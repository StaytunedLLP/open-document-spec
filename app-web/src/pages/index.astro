          </div>

          <!-- Visual Graphic: 2 Targeted Pages connecting to AI -->
          <div class="exact-graphic-box">
            <svg viewBox="0 0 320 200" fill="none" xmlns="http://www.w3.org/2000/svg" class="graphic-svg">
              <!-- Page 1 -->
              <g class="page-1">
                <rect x="92" y="22" width="56" height="74" rx="5" fill="var(--card-bg)" stroke="#10b981" stroke-width="2"/>
                <line x1="106" y1="38" x2="134" y2="38" stroke="#10b981" stroke-width="3" stroke-linecap="round"/>
                <line x1="106" y1="50" x2="128" y2="50" stroke="var(--border-color)" stroke-width="2.5" stroke-linecap="round"/>
                <line x1="106" y1="62" x2="134" y2="62" stroke="var(--border-color)" stroke-width="2.5" stroke-linecap="round"/>
                <line x1="106" y1="74" x2="124" y2="74" stroke="var(--border-color)" stroke-width="2.5" stroke-linecap="round"/>
              </g>

              <!-- Page 2 -->
              <g class="page-2">
                <rect x="172" y="22" width="56" height="74" rx="5" fill="var(--card-bg)" stroke="#10b981" stroke-width="2"/>
                <line x1="186" y1="38" x2="214" y2="38" stroke="#10b981" stroke-width="3" stroke-linecap="round"/>
                <line x1="186" y1="50" x2="208" y2="50" stroke="var(--border-color)" stroke-width="2.5" stroke-linecap="round"/>
