---
// FILE: index.astro
// Purpose: High-Converting ODS Landing Page with Interactive Hero Token Calculator & Pareto 80/20 Core Features.
// Preserves ods visual design system & dark theme (#09090b).

import AIIcon from "../components/AIIcon.astro";
import Icon from "../components/Icon.astro";
import Layout from "../layouts/Layout.astro";
import { REPO_URL } from "../lib/releases";
---

<Layout activeNav="home">
  <!-- Background Dot-Matrix Graphic Pattern -->
  <div class="dot-matrix-bg"></div>

  <!-- Funnel Step 1: Hero Header with Interactive ROI Token Calculator -->
  <section class="hero-section">
    <!-- Ethereal Animated Soft Blur Visual Gradient & Waves Backdrop -->
    <div class="hero-visual-gradient-backdrop" aria-hidden="true">
      <div class="hero-glow-blob blob-mint"></div>
      <div class="hero-glow-blob blob-blue"></div>
      <div class="hero-glow-blob blob-soft"></div>
      <div class="hero-glow-blob blob-bottom-sync"></div>
      <div class="hero-waves-wrapper">
        <svg class="hero-waves-svg" viewBox="0 0 1440 900" fill="none" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
          <path d="M 720 -120 C 1020 120, 1300 380, 1480 820" stroke="url(#hero-wave-1)" stroke-width="1.8" opacity="0.4" />
          <path d="M 780 -90 C 1080 160, 1340 430, 1520 860" stroke="url(#hero-wave-1)" stroke-width="1.2" opacity="0.28" />
          <path d="M 840 -60 C 1140 200, 1380 480, 1560 900" stroke="url(#hero-wave-1)" stroke-width="0.8" opacity="0.18" />
          <path d="M -160 480 C 140 640, 540 740, 1080 890" stroke="url(#hero-wave-2)" stroke-width="1.5" opacity="0.32" />
          <path d="M -100 550 C 200 700, 600 780, 1140 930" stroke="url(#hero-wave-2)" stroke-width="1" opacity="0.22" />
          <defs>
            <linearGradient id="hero-wave-1" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#3b82f6" stop-opacity="0.65"/>
              <stop offset="60%" stop-color="#60a5fa" stop-opacity="0.35"/>
              <stop offset="100%" stop-color="#10b981" stop-opacity="0.05"/>
            </linearGradient>
            <linearGradient id="hero-wave-2" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#10b981" stop-opacity="0.6"/>
              <stop offset="50%" stop-color="#34d399" stop-opacity="0.3"/>
              <stop offset="100%" stop-color="#60a5fa" stop-opacity="0.05"/>
            </linearGradient>
          </defs>
        </svg>
      </div>
      <div class="hero-dot-matrix"></div>
      <div class="hero-bottom-gradient-sync"></div>
    </div>

    <div class="pill-badge-wrap">
      <div class="pill-badge">
        <span class="pill-dot"></span>
        <span>Open Document Spec (ODS)</span>
        <span class="pill-sep">•</span>
        <span>Skill-First AI Context Engine</span>
      </div>
    </div>

    <h1 class="tagline">Make your documents easy for people and AI to understand.</h1>

    <p class="hero-subtext">
      Think of <strong>Open Document Spec (ODS)</strong> like smart sticky notes for your files. Instead of making AI (like ChatGPT, Claude, or Cursor) read a whole giant folder to answer one question, ODS shows it the exact right page, giving you faster answers while <strong>saving up to 94% in AI costs</strong>!
    </p>

    <div class="hero-actions">
      <a id="download-btn" href="/docs" class="hero-button shimmer-btn">
        <svg class="hero-button-sparkle" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3z"/></svg>
        <span id="download-label">Enable ODS AI Skill</span>
        <span class="hero-button-arrow">→</span>
      </a>

      <a href="/features" class="hero-secondary-button">Explore All 38 Features →</a>
    </div>

    <a href={REPO_URL} target="_blank" rel="noopener noreferrer" class="other-platforms">
      Install the direct tool for your terminal (Shell or Cargo) →
    </a>

    <!-- Interactive CLI Terminal Simulator Box inside Hero -->
    <div class="cli-wrap glow-card">
      <div class="cli-header">
        <div class="cli-dots">
          <span class="dot red"></span>
          <span class="dot yellow"></span>
          <span class="dot green"></span>
        </div>
        <span class="cli-title">ODS Smart Reading List Tool</span>
        <span class="cli-tag">SUPER-FAST &lt; 5MS</span>
      </div>
      <div class="cli-body">
        <div class="cli-line">
          <span class="cli-prompt">$</span>
          <span class="cli-command">ods context docs/guide/01-introduction.md</span>
          <button id="copy-cmd-btn" class="cli-copy-btn" title="Copy Command">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
          </button>
        </div>
        <div class="cli-output">
          <div class="cli-tree">
            Smart Reading List for [01-introduction.md]:<br/>
            ├── docs/guide/01-introduction.md <span class="tree-tag">(Main page)</span><br/>
            ├── specs/ods/intro.md <span class="tree-tag">(linked page)</span><br/>
            ├── docs/guide/05-profiles.md <span class="tree-tag">(related page)</span><br/>
            └── src/crates/ods-core/src/graph.rs <span class="tree-tag">(connected code)</span>
          </div>
          <div class="cli-log"><span class="cli-checkmark">✓</span> Total Context Size: 4,120 tokens (saves 94% compared to reading all documents)</div>
          <div class="cli-log"><span class="cli-checkmark">✓</span> Annual Savings: 94.97% less cost and faster AI assistant answers</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Metrics & Social Proof Strip -->
  <section class="section-container metrics-strip-section">
    <div class="metrics-grid">
      <div class="metric-card minimal-card glow-card">
        <div class="metric-value-row">
          <span class="metric-value">94.97%</span>
          <span class="metric-icon-subtle"><Icon name="sparkles" size={18} /></span>
        </div>
        <div class="metric-label">Saved in AI Cost</div>
        <p class="metric-sub">Sends only the exact pages AI needs.</p>
      </div>

      <div class="metric-card minimal-card glow-card">
        <div class="metric-value-row">
          <span class="metric-value">&lt; 5ms</span>
          <span class="metric-icon-subtle"><Icon name="lightning" size={18} /></span>
        </div>
        <div class="metric-label">Scanning Speed</div>
        <p class="metric-sub">Instant context lookup in under 5ms.</p>
      </div>

      <div class="metric-card minimal-card glow-card">
        <div class="metric-value-row">
          <span class="metric-value">17+</span>
          <span class="metric-icon-subtle"><Icon name="robot" size={18} /></span>
        </div>
        <div class="metric-label">AI Tools Supported</div>
        <p class="metric-sub">ChatGPT, Claude, Cursor & 17+ tools.</p>
      </div>

      <div class="metric-card minimal-card glow-card">
        <div class="metric-value-row">
          <span class="metric-value">100%</span>
          <span class="metric-icon-subtle"><Icon name="shield" size={18} /></span>
        </div>
        <div class="metric-label">Private & Secure</div>
        <p class="metric-sub">Runs completely local on your machine.</p>
      </div>
    </div>
  </section>

  <!-- ODS Context Precision Comparison Section -->
  <section class="section-container cookbook-analogy-section" id="cookbook-example">
    <h2 class="section-heading">How ODS Works</h2>
    <p class="section-subheading">ODS builds a precise reading list before AI starts processing, eliminating unnecessary context, reducing cost, and improving accuracy.</p>

    <div class="exact-comparison-wrapper">
      <!-- 2 Main Cards Grid -->
      <div class="exact-comparison-grid">
        
        <!-- CARD 1: WITHOUT ODS -->
        <div class="exact-card mode-without">
          <!-- Top Badge -->
          <div class="exact-badge badge-red">
            <span class="dot red"></span>
            <span>WITHOUT ODS</span>
          </div>

          <!-- Visual Graphic: Stack of 1000 pages connecting to AI -->
          <div class="exact-graphic-box">
            <svg viewBox="0 0 320 200" fill="none" xmlns="http://www.w3.org/2000/svg" class="graphic-svg">
              <!-- Grid of Stacked Pages -->
              <g class="pages-grid" opacity="0.95">
                <!-- Row 1 (Back) -->
                <rect x="25" y="20" width="30" height="42" rx="3" fill="var(--bg)" stroke="var(--border-color)" stroke-width="1.2"/>
                <line x1="31" y1="30" x2="49" y2="30" stroke="var(--border-color)" stroke-width="1.8"/>
                <line x1="31" y1="37" x2="45" y2="37" stroke="var(--border-color)" stroke-width="1.8"/>
                <line x1="31" y1="44" x2="49" y2="44" stroke="var(--border-color)" stroke-width="1.8"/>

                <rect x="60" y="20" width="30" height="42" rx="3" fill="var(--bg)" stroke="var(--border-color)" stroke-width="1.2"/>
                <line x1="66" y1="30" x2="84" y2="30" stroke="var(--border-color)" stroke-width="1.8"/>
                <line x1="66" y1="37" x2="80" y2="37" stroke="var(--border-color)" stroke-width="1.8"/>
                <line x1="66" y1="44" x2="84" y2="44" stroke="var(--border-color)" stroke-width="1.8"/>

                <rect x="95" y="20" width="30" height="42" rx="3" fill="var(--bg)" stroke="var(--border-color)" stroke-width="1.2"/>
                <line x1="101" y1="30" x2="119" y2="30" stroke="var(--border-color)" stroke-width="1.8"/>
                <line x1="101" y1="37" x2="115" y2="37" stroke="var(--border-color)" stroke-width="1.8"/>
                <line x1="101" y1="44" x2="119" y2="44" stroke="var(--border-color)" stroke-width="1.8"/>

                <rect x="130" y="20" width="30" height="42" rx="3" fill="var(--bg)" stroke="var(--border-color)" stroke-width="1.2"/>
                <line x1="136" y1="30" x2="154" y2="30" stroke="var(--border-color)" stroke-width="1.8"/>
                <line x1="136" y1="37" x2="150" y2="37" stroke="var(--border-color)" stroke-width="1.8"/>
                <line x1="136" y1="44" x2="154" y2="44" stroke="var(--border-color)" stroke-width="1.8"/>

                <rect x="165" y="20" width="30" height="42" rx="3" fill="var(--bg)" stroke="var(--border-color)" stroke-width="1.2"/>
                <line x1="171" y1="30" x2="189" y2="30" stroke="var(--border-color)" stroke-width="1.8"/>
                <line x1="171" y1="37" x2="185" y2="37" stroke="var(--border-color)" stroke-width="1.8"/>
                <line x1="171" y1="44" x2="189" y2="44" stroke="var(--border-color)" stroke-width="1.8"/>

                <rect x="200" y="20" width="30" height="42" rx="3" fill="var(--bg)" stroke="var(--border-color)" stroke-width="1.2"/>
                <line x1="206" y1="30" x2="224" y2="30" stroke="var(--border-color)" stroke-width="1.8"/>
                <line x1="206" y1="37" x2="220" y2="37" stroke="var(--border-color)" stroke-width="1.8"/>
                <line x1="206" y1="44" x2="224" y2="44" stroke="var(--border-color)" stroke-width="1.8"/>

                <rect x="235" y="20" width="30" height="42" rx="3" fill="var(--bg)" stroke="var(--border-color)" stroke-width="1.2"/>
                <line x1="241" y1="30" x2="259" y2="30" stroke="var(--border-color)" stroke-width="1.8"/>
                <line x1="241" y1="37" x2="255" y2="37" stroke="var(--border-color)" stroke-width="1.8"/>
                <line x1="241" y1="44" x2="259" y2="44" stroke="var(--border-color)" stroke-width="1.8"/>

                <rect x="270" y="20" width="30" height="42" rx="3" fill="var(--bg)" stroke="var(--border-color)" stroke-width="1.2"/>
                <line x1="276" y1="30" x2="294" y2="30" stroke="var(--border-color)" stroke-width="1.8"/>
                <line x1="276" y1="37" x2="290" y2="37" stroke="var(--border-color)" stroke-width="1.8"/>
                <line x1="276" y1="44" x2="294" y2="44" stroke="var(--border-color)" stroke-width="1.8"/>

                <!-- Row 2 (Front) -->
                <rect x="33" y="34" width="30" height="42" rx="3" fill="var(--card-bg)" stroke="var(--border-color)" stroke-width="1.5"/>
                <line x1="39" y1="44" x2="57" y2="44" stroke="var(--fg-muted)" opacity="0.6" stroke-width="1.8"/>
                <line x1="39" y1="51" x2="53" y2="51" stroke="var(--fg-muted)" opacity="0.6" stroke-width="1.8"/>
                <line x1="39" y1="58" x2="57" y2="58" stroke="var(--fg-muted)" opacity="0.6" stroke-width="1.8"/>

                <rect x="68" y="34" width="30" height="42" rx="3" fill="var(--card-bg)" stroke="var(--border-color)" stroke-width="1.5"/>
                <line x1="74" y1="44" x2="92" y2="44" stroke="var(--fg-muted)" opacity="0.6" stroke-width="1.8"/>
                <line x1="74" y1="51" x2="88" y2="51" stroke="var(--fg-muted)" opacity="0.6" stroke-width="1.8"/>
                <line x1="74" y1="58" x2="92" y2="58" stroke="var(--fg-muted)" opacity="0.6" stroke-width="1.8"/>

                <rect x="103" y="34" width="30" height="42" rx="3" fill="var(--card-bg)" stroke="var(--border-color)" stroke-width="1.5"/>
                <line x1="109" y1="44" x2="127" y2="44" stroke="var(--fg-muted)" opacity="0.6" stroke-width="1.8"/>
                <line x1="109" y1="51" x2="123" y2="51" stroke="var(--fg-muted)" opacity="0.6" stroke-width="1.8"/>
                <line x1="109" y1="58" x2="127" y2="58" stroke="var(--fg-muted)" opacity="0.6" stroke-width="1.8"/>

                <rect x="138" y="34" width="30" height="42" rx="3" fill="var(--card-bg)" stroke="var(--border-color)" stroke-width="1.5"/>
                <line x1="144" y1="44" x2="162" y2="44" stroke="var(--fg-muted)" opacity="0.6" stroke-width="1.8"/>
                <line x1="144" y1="51" x2="158" y2="51" stroke="var(--fg-muted)" opacity="0.6" stroke-width="1.8"/>
                <line x1="144" y1="58" x2="162" y2="58" stroke="var(--fg-muted)" opacity="0.6" stroke-width="1.8"/>

                <rect x="173" y="34" width="30" height="42" rx="3" fill="var(--card-bg)" stroke="var(--border-color)" stroke-width="1.5"/>
                <line x1="179" y1="44" x2="197" y2="44" stroke="var(--fg-muted)" opacity="0.6" stroke-width="1.8"/>
                <line x1="179" y1="51" x2="193" y2="51" stroke="var(--fg-muted)" opacity="0.6" stroke-width="1.8"/>
                <line x1="179" y1="58" x2="197" y2="58" stroke="var(--fg-muted)" opacity="0.6" stroke-width="1.8"/>

                <rect x="208" y="34" width="30" height="42" rx="3" fill="var(--card-bg)" stroke="var(--border-color)" stroke-width="1.5"/>
                <line x1="214" y1="44" x2="232" y2="44" stroke="var(--fg-muted)" opacity="0.6" stroke-width="1.8"/>
                <line x1="214" y1="51" x2="228" y2="51" stroke="var(--fg-muted)" opacity="0.6" stroke-width="1.8"/>
                <line x1="214" y1="58" x2="232" y2="58" stroke="var(--fg-muted)" opacity="0.6" stroke-width="1.8"/>

                <rect x="243" y="34" width="30" height="42" rx="3" fill="var(--card-bg)" stroke="var(--border-color)" stroke-width="1.5"/>
                <line x1="249" y1="44" x2="267" y2="44" stroke="var(--fg-muted)" opacity="0.6" stroke-width="1.8"/>
                <line x1="249" y1="51" x2="263" y2="51" stroke="var(--fg-muted)" opacity="0.6" stroke-width="1.8"/>
                <line x1="249" y1="58" x2="267" y2="58" stroke="var(--fg-muted)" opacity="0.6" stroke-width="1.8"/>
              </g>

              <!-- Dashed line down to AI -->
              <line x1="160" y1="84" x2="160" y2="132" stroke="var(--fg-muted)" opacity="0.6" stroke-width="2" stroke-dasharray="4 4"/>

              <!-- Circle AI node -->
              <circle cx="160" cy="154" r="20" fill="var(--card-bg)" stroke="var(--fg-muted)" stroke-width="2"/>
              <text x="160" y="159" fill="var(--fg)" font-family="Inter, sans-serif" font-size="13" font-weight="700" text-anchor="middle">AI</text>
            </svg>
          </div>

          <!-- Metrics Table -->
          <div class="exact-metrics-table">
            <div class="exact-row">
              <div class="row-left">
                <span class="icon-circle"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg></span>
                <span class="row-title">Pages Read</span>
              </div>
              <div class="row-right">
                <span class="num red">1,000</span>
                <span class="unit">Pages</span>
              </div>
            </div>

            <div class="exact-row">
              <div class="row-left">
                <span class="icon-circle"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg></span>
                <span class="row-title">Text Sent to AI</span>
              </div>
              <div class="row-right">
                <span class="num red">80,000</span>
                <span class="unit">Words</span>
              </div>
            </div>

            <div class="exact-row">
              <div class="row-left">
                <span class="icon-circle"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></span>
                <span class="row-title">Response Time</span>
              </div>
              <div class="row-right">
                <span class="num red">25.4</span>
                <span class="unit">Seconds</span>
              </div>
            </div>

            <div class="exact-row">
              <div class="row-left">
                <span class="icon-circle"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></span>
                <span class="row-title">Cost per Query</span>
              </div>
              <div class="row-right">
                <span class="num red">$0.25</span>
              </div>
            </div>
          </div>

          <!-- Bullet Points -->
          <ul class="exact-bullet-list">
            <li>
              <span class="bullet-cross">✕</span>
              <span>Reads thousands of irrelevant pages</span>
            </li>
            <li>
              <span class="bullet-cross">✕</span>
              <span>High token usage and processing cost</span>
            </li>
            <li>
              <span class="bullet-cross">✕</span>
              <span>Higher risk of context mix-ups and hallucinations</span>
            </li>
