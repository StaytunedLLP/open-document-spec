---
// FILE: pricing.astro
// Purpose: Pricing & Pro Tiers status page for ODS (100% Free Core Available, Pro & Enterprise Cloud Tiers Coming Soon).
// Layer: Marketing page

import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { REPO_URL } from "../lib/releases";
---

<Layout title="Pricing: Open Document Spec (ODS)" activeNav="pricing">
  <div class="page-container">
    <div class="header-section">
      <div class="pill-badge coming-soon-pill">
        <span class="pulse-dot"></span>
        100% Free Core • Pro Tiers Coming Soon
      </div>
      <h1 class="page-title">Pricing & Cloud Plans</h1>
      <p class="page-subtitle">
        Open Document Spec (ODS) core is 100% Free & Open Source under Apache 2.0. Hosted cloud backup, team live sync, and enterprise controls are currently in active development.
      </p>
    </div>

    <!-- Single Unified Coming Soon Container -->
    <div class="coming-soon-main-card glow-card">
      <div class="card-header-badge">
        <span class="pulse-dot"></span>
        PRICING TIERS & AVAILABILITY
      </div>

      <div class="coming-soon-tiers">
        <div class="tier-pill">
          <span class="pulse-dot-green"></span>
          <span class="tier-name">Community Core</span>
          <span class="tier-badge available">Free forever</span>
        </div>
        <div class="tier-pill">
          <span class="tier-dot"></span>
          <span class="tier-name">ODS Pro Cloud</span>
          <span class="tier-badge coming-soon">Coming Soon</span>
        </div>
        <div class="tier-pill">
          <span class="tier-dot"></span>
          <span class="tier-name">Enterprise Team</span>
          <span class="tier-badge coming-soon">Coming Soon</span>
        </div>
      </div>

      <p class="card-main-subtext">
        Open Document Spec core is completely free and open-source under the Apache 2.0 license. Managed cloud synchronization, team graph collaboration, and enterprise compliance tools are launching soon.
      </p>
    </div>

    <!-- ROI Metric Breakdown -->
    <div class="roi-section">
      <h2>AI Savings Impact</h2>
      <div class="roi-grid">
        <div class="roi-card">
          <span class="roi-stat">8,200 → 410</span>
          <h4>Words per Question</h4>
          <p>Loads only exact linked pages required by the task.</p>
        </div>
        <div class="roi-card">
          <span class="roi-stat">94%</span>
          <h4>Cost Savings</h4>
          <p>Reduces word count sent to Claude, GPT-4o, and Gemini models.</p>
        </div>
        <div class="roi-card">
          <span class="roi-stat">&lt; 5ms</span>
          <h4>Instant Speed</h4>
          <p>Fast index checking avoids long file scanning delays.</p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  /* ── Coming Soon Pill & Pulse Dot ── */
  .coming-soon-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-10);
    padding: var(--space-6) var(--space-16);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--action-fg);
    box-shadow: 0 0 10px var(--action-fg);
    animation: pulse-glow 2s infinite;
  }

  @keyframes pulse-glow {
    0% { opacity: 0.4; transform: scale(0.9); }
    50% { opacity: 1; transform: scale(1.2); }
    100% { opacity: 0.4; transform: scale(0.9); }
  }

  .page-container {
    width: min(92vw, 1040px);
    margin: 0 auto;
    padding-top: var(--space-64);
    padding-bottom: var(--space-64);
  }

  .header-section {
    text-align: center;
    margin-bottom: var(--space-48);
  }

  .pill-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: var(--space-6) var(--space-16);
    background: var(--card-bg);
    border: var(--border);
    border-radius: var(--radius-pill);
    color: var(--fg-muted);
    margin-bottom: var(--space-20);
  }

  .page-title {
    font-size: clamp(2.4rem, 5.2vw, 3.4rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-20);
    color: var(--fg);
  }

  .page-subtitle {
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--fg-muted);
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.65;
  }

  /* ── Single Unified Coming Soon Container ── */
  .coming-soon-main-card {
    background: var(--card-bg);
    border: var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-48) var(--space-48);
    margin-top: var(--space-24);
    margin-bottom: var(--space-64);
    text-align: center;
    position: relative;
  }

  .card-header-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--action-fg);
    background: var(--action-bg);
    padding: 0.45rem 1.15rem;
    border-radius: var(--radius-pill);
    margin-bottom: var(--space-20);
    letter-spacing: 0.04em;
    line-height: 1;
    max-width: 100%;
  }

  .pulse-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--action-fg);
    box-shadow: 0 0 8px var(--action-fg);
    animation: pulse-glow 2s infinite;
    flex-shrink: 0;
  }

  @keyframes pulse-glow {
    0% { opacity: 0.4; transform: scale(0.9); }
    50% { opacity: 1; transform: scale(1.2); }
    100% { opacity: 0.4; transform: scale(0.9); }
  }

  .card-main-heading {
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: 700;
    color: var(--fg);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-16);
    max-width: 780px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.25;
  }

  .coming-soon-main-card .card-main-subtext {
    font-size: 1.025rem !important;
    color: var(--fg-muted) !important;
    line-height: 1.65 !important;
    text-align: center !important;
    text-wrap: pretty !important;
    max-width: 660px !important;
    margin: 0 auto var(--space-28) !important;
    display: block !important;
  }

  .coming-soon-tiers {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-12);
    margin-bottom: var(--space-32);
    flex-wrap: wrap;
  }

  .tier-pill {
    display: flex;
    align-items: center;
    gap: var(--space-12);
    background: var(--nested-card-bg);
    border: var(--border);
    border-radius: var(--radius-pill);
    padding: var(--space-8) var(--space-16);
    font-size: 0.9rem;
    font-weight: 550;
    color: var(--fg);
    transition: border-color 0.2s ease;
  }

  .tier-pill:hover {
    border-color: var(--fg-dim);
  }

  .tier-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--fg-muted);
    opacity: 0.6;
  }

  .pulse-dot-green {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #10b981;
    box-shadow: 0 0 8px rgba(16, 185, 129, 0.6);
    animation: pulse-glow-green 2s infinite;
    flex-shrink: 0;
  }

  @keyframes pulse-glow-green {
    0% { opacity: 0.4; transform: scale(0.9); }
    50% { opacity: 1; transform: scale(1.2); }
    100% { opacity: 0.4; transform: scale(0.9); }
  }

  .tier-badge {
    font-family: var(--font-mono);
    font-size: 0.725rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-pill);
    line-height: 1;
  }

  .tier-badge.available {
    background: rgba(16, 185, 129, 0.1);
    color: #10b981;
    border: 1px solid rgba(16, 185, 129, 0.2);
  }

  .tier-badge.coming-soon {
    background: var(--action-bg);
    color: var(--action-fg);
  }

  .card-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-16);
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-12) var(--space-24);
    border-radius: var(--radius-sm) !important;
    font-weight: 600;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    text-decoration: none;
    transition: all 0.2s ease;
    line-height: 1.2;
  }

  .cta-button.primary {
    background: var(--action-bg);
    color: var(--action-fg);
    border: 1px solid var(--action-bg);
    border-radius: var(--radius-sm) !important;
  }

  .cta-button.primary:hover {
    opacity: 0.9;
  }

  .cta-button.outline {
    background: var(--secondary-action-bg);
    border: var(--secondary-action-border);
    color: var(--secondary-action-fg);
    border-radius: var(--radius-sm) !important;
  }

  .cta-button.outline:hover {
    background: var(--nested-card-bg);
    border-color: var(--fg-dim);
  }

  .cta-button.text-link {
    background: transparent;
    color: var(--fg-muted);
    padding: var(--space-12) var(--space-16);
    border-radius: var(--radius-sm) !important;
  }

  .cta-button.text-link:hover {
    color: var(--fg);
  }

  /* ── ROI Section ── */
  .roi-section {
    text-align: center;
  }

  .roi-section h2 {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--fg);
    margin-bottom: var(--space-32);
  }

  .roi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-20);
    text-align: left;
  }

  .roi-card {
    background: var(--card-bg);
    border: var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-24);
    transition: border-color 0.2s ease;
  }

  .roi-card:hover {
    border-color: var(--fg-dim);
  }

  .roi-stat {
    font-family: var(--font-mono);
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--fg);
    display: block;
    margin-bottom: var(--space-4);
  }

  .roi-card h4 {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--fg);
    margin-bottom: var(--space-4);
  }

  .roi-card p {
    font-size: 0.825rem;
    color: var(--fg-muted);
    line-height: 1.5;
  }

  /* ── Responsive Mobile Optimizations ── */
  @media (max-width: 768px) {
    .page-container {
      padding-top: var(--space-36);
      padding-bottom: var(--space-48);
    }

    .coming-soon-main-card {
      padding: var(--space-28) var(--space-16);
      margin-top: var(--space-16);
      margin-bottom: var(--space-48);
    }

    .card-header-badge {
      font-size: 0.7rem;
      padding: 0.35rem 0.85rem;
      margin-bottom: var(--space-20);
    }

    .card-main-heading {
      font-size: 1.35rem;
      margin-bottom: var(--space-12);
    }

    .coming-soon-main-card .card-main-subtext {
      font-size: 0.9rem !important;
      line-height: 1.55 !important;
      margin-bottom: var(--space-28) !important;
      text-align: center !important;
      text-wrap: balance !important;
    }

    .coming-soon-tiers {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-12);
      margin-bottom: var(--space-36);
    }

    .tier-pill {
      justify-content: space-between;
      padding: var(--space-12) var(--space-16);
      font-size: 0.9rem;
    }

    .card-actions {
      flex-direction: column;
      width: 100%;
      gap: var(--space-12);
      margin-top: 0.5rem;
    }

    .cta-button {
      width: 100%;
      box-sizing: border-box;
      font-size: 0.825rem;
      padding: var(--space-12) var(--space-16);
    }
  }
</style>
