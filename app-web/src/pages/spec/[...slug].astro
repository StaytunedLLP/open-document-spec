---
// FILE: src/pages/spec/[...slug].astro
// Purpose: Dynamic route rendering spec markdown files in content/specs collection inside the site shell. Supports both extensionless and .md URLs.

import { getCollection, render } from "astro:content";
import DocShell from "../../components/DocShell.astro";

export async function getStaticPaths() {
  const specs = await getCollection("specs");
  const paths: Array<{ params: { slug: string }; props: { entry: any } }> = [];

  specs.forEach((entry) => {
    const cleanSlug = entry.id.replace(/\.(md|mdx)$/, "");
    paths.push({
      params: { slug: cleanSlug },
      props: { entry },
    });

    // Also register the exact file id (e.g. "ods/graph.md") to prevent 404s if accessed directly
    if (entry.id !== cleanSlug) {
      paths.push({
        params: { slug: entry.id },
        props: { entry },
      });
    }
  });

  return paths;
}

const { entry } = Astro.props;
const allEntries = await getCollection("specs");
const { Content, headings } = await render(entry);
---

<DocShell
  collection="specs"
  currentEntry={entry}
  allEntries={allEntries}
  Content={Content}
  headings={headings}
/>
