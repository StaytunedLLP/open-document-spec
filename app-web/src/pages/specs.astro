---
// FILE: src/pages/specs.astro
// Purpose: Plural /specs root route rendering the main SPEC.md document inside DocShell.

import { getCollection, render } from "astro:content";
import DocShell from "../components/DocShell.astro";

const allEntries = await getCollection("specs");
const mainSpec = allEntries.find((e) => (e.id || "").includes("SPEC")) || allEntries[0];
const { Content, headings } = await render(mainSpec);
---

<DocShell
  collection="specs"
  currentEntry={mainSpec}
  allEntries={allEntries}
  Content={Content}
  headings={headings}
/>
