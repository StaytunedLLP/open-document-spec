---
// FILE: src/pages/specs/[...slug].astro
// Purpose: Plural /specs route handler mapping /specs/* URLs cleanly to spec entries to prevent 404s for plural URLs like /specs/graph.

import { getCollection, render } from "astro:content";
import DocShell from "../../components/DocShell.astro";

export async function getStaticPaths() {
  const specs = await getCollection("specs");
  const paths: Array<{ params: { slug: string | undefined }; props: { entry: any } }> = [];

  specs.forEach((entry) => {
    const cleanSlug = entry.id.replace(/\.(md|mdx)$/, "");
    paths.push({
      params: { slug: cleanSlug },
      props: { entry },
    });

    if (entry.id !== cleanSlug) {
      paths.push({
        params: { slug: entry.id },
        props: { entry },
      });
    }
  });

  return paths;
}

const { entry } = Astro.props;
const allEntries = await getCollection("specs");
const { Content, headings } = await render(entry);
---

<DocShell
  collection="specs"
  currentEntry={entry}
  allEntries={allEntries}
  Content={Content}
  headings={headings}
/>
